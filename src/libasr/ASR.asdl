-- Abstract Semantic Representation (ASR) definition

-- Documenations are available at:
-- https://github.com/lfortran/lfortran/tree/main/doc/src/asr/asr.md

module ASR {

unit
    = TranslationUnit(symbol_table symtab, node* items, identifier? global_init)

symbol
    = Program(symbol_table symtab, identifier name, identifier* dependencies, stmt* body, identifier? global_init, location start_name, location end_name)
    | Module(symbol_table symtab, identifier name, identifier? parent_module, identifier* dependencies, bool loaded_from_mod, bool intrinsic, bool has_submodules, identifier? global_init, location start_name, location end_name)
    | Function(symbol_table symtab, identifier name, ttype function_signature, identifier* dependencies, expr* args, stmt* body, expr? return_var, access access, bool deterministic, bool side_effect_free, string? module_file, gpu_kernel_layout? gpu, location start_name, location end_name)
    | GenericProcedure(symbol_table parent_symtab, identifier name, symbol* procs, access access)
    | CustomOperator(symbol_table parent_symtab, identifier name, symbol* procs, access access)
    | ExternalSymbol(symbol_table parent_symtab, identifier name, symbol external, identifier module_name, identifier* scope_names, identifier original_name, access access)
    | Struct(symbol_table symtab, identifier name, ttype struct_signature, identifier* dependencies, identifier* members, identifier* member_functions, abi abi, access access, bool is_packed, bool is_abstract, bool is_sequence, call_arg* initializers, expr? alignment, symbol? parent, identifier* kind_params)
    | Enum(symbol_table symtab, identifier name, identifier* dependencies, identifier* members, abi abi, access access, enumtype enum_value_type, ttype type, symbol? parent)
    | Union(symbol_table symtab, identifier name, identifier* dependencies, identifier* members, abi abi, access access, call_arg* initializers, symbol? parent)
    -- A Local integer Variable of Default storage whose symbolic_value is not
    -- constant and whose value is empty is initialized on every entry to its
    -- procedure or BLOCK, before the declarations that depend on it
    -- (ASRUtils::is_entry_initialized_local). The function_call_in_declaration
    -- pass creates such locals to evaluate automatic array bounds exactly
    -- once. The initializer references only dummy arguments, host or module
    -- entities, parameters and other such locals (checked by asr_verify).
    -- A Variable whose common_block is present has no storage of its own: it
    -- lives in the storage of that CommonBlock of its own symbol table, as one
    -- of its members or as the variable of one of its associations.
    | Variable(symbol_table parent_symtab, identifier name, identifier* dependencies, intent intent,
               expr? symbolic_value, expr? value, storage_type storage, ttype type, symbol? type_declaration,
               abi abi, access access, presence presence, bool value_attr, bool target_attr, bool contiguous_attr,
               string? bindc_name, bool is_volatile, bool is_asynchronous, bool is_protected, pass_attr pass_attr,
               identifier? self_argument, codimension* codims, symbol? common_block)
    -- A scoped redeclaration of a host/use-associated variable. This is a
    -- declaration reference, not a runtime access rewritten by expression
    -- lowering; the canonical entity's declaration is not modified.
    | ScopedVariableAttribute(symbol_table parent_symtab, identifier name, symbol variable, bool is_volatile, bool is_asynchronous)
    | StructMethodDeclaration(symbol_table parent_symtab, identifier name, identifier? self_argument, identifier proc_name, symbol proc, abi abi, bool is_deferred, bool is_nopass)
    | AssociateBlock(symbol_table symtab, identifier name, stmt* body)
    | Block(symbol_table symtab, identifier name, stmt* body)
    | Requirement(symbol_table symtab, identifier name, identifier* args, require_instantiation* requires)
    | Template(symbol_table symtab, identifier name, identifier* args, require_instantiation* requires)
    | Namelist(symbol_table parent_symtab, identifier group_name, symbol* var_list)
    -- A BLOCK DATA program unit. It has no executable statements: the DATA
    -- values it gives are the initializers of its own variables.
    -- block_data_name is absent for the unnamed BLOCK DATA.
    | BlockData(symbol_table symtab, identifier name, identifier? block_data_name, identifier* dependencies, location start_name, location end_name)
    -- The view of one common block that one scoping unit declares. `name` is
    -- the key in parent_symtab, distinct from any Fortran name; block_name is
    -- the source name, absent for blank COMMON. Every unit that names the same
    -- block has its own CommonBlock with the same link_name, the global symbol
    -- of the shared storage. `members` are the variables of the COMMON
    -- statements in order, laid out one after another; `associations` place
    -- the other variables that EQUIVALENCE connects to the block.
    | CommonBlock(symbol_table parent_symtab, identifier name, identifier? block_name, identifier link_name, symbol* members, common_association* associations, abi abi, storage_type storage, common_block_role role)

stmt
    = Allocate(alloc_arg* args, expr? stat, expr? errmsg, expr? source)
    -- Reallocation on assignment of the one object in `args`: it is
    -- allocated with the shape of `args` when it is not allocated, or when
    -- `shape_differs`, a scalar logical evaluated only while the object is
    -- allocated, is true (F2018 10.2.1.3)
    | ReAlloc(alloc_arg* args, expr shape_differs)
    | Assign(int label, identifier variable)
    -- new_target is true when the target is a new object that the assignment
    -- only defines, such as an element of an array allocated with SOURCE=
    -- (F2018 9.7.1.2). The value is copied into it: unlike the variable of
    -- an intrinsic assignment, it is not finalized first (F2018 7.5.6.3)
    -- and its components are not assigned by defined assignment (10.2.1.3).
    -- new_allocation is true when the target is an allocatable variable
    -- that was unallocated and has just been allocated for this intrinsic
    -- assignment (F2018 10.2.1.3 p3). Being an unallocated allocatable
    -- variable, it is not finalized (F2018 7.5.6.3), but it is otherwise
    -- assigned as the variable of an intrinsic assignment.
    | Assignment(expr target, expr value, stmt? overloaded, bool realloc_lhs, bool move_allocation, bool new_target, bool new_allocation)
    -- The run-time shape check of an array assignment: `checks` are the
    -- extents it compares, in that order (see array_extent_check)
    | DebugCheckArrayBounds(expr target, expr* components, array_extent_check* checks, bool move_allocation)
    -- Pointer assignment `target => value`. A target that is an array
    -- section of a pointer gives the bounds of the pointer: `form` is
    -- PointerBoundsSpec for a bounds-spec-list (`p(lb:) => a`: only the
    -- lower bounds are present, the extents are those of the value) and
    -- PointerBoundsRemapping for a bounds-remapping-list (`p(lb:ub) => a`,
    -- F2018 10.2.2.3). Every other association has NoPointerBounds.
    | Associate(expr target, expr value, pointer_bounds_form form)
    | Cycle(identifier? stmt_name)
    | ExplicitDeallocate(expr* vars, expr? stat, expr? errmsg)
    | ImplicitDeallocate(expr* vars)
    | DoConcurrentLoop(do_loop_head* head, expr* shared, expr* local, reduction_expr* reduction, stmt* body)
    | OMPRegion(omp_region_type region, omp_clause* clauses, stmt* body, exec_target exec_target)
    | DoLoop(identifier? name, do_loop_head head, stmt* body, stmt* orelse)
    | ErrorStop(expr? code)
    | Exit(identifier? stmt_name)
    | ForAllSingle(do_loop_head head, stmt assign_stmt)
    | ForEach(expr var, expr container, stmt* body)
    | GoTo(int target_id, identifier name)
    | GoToTarget(int id, identifier name)
    | If(identifier? name, expr test, stmt* body, stmt* orelse)
    | IfArithmetic(expr test, int lt_label, int eq_label, int gt_label)
    | Print(expr text)
    | FileOpen(int label, expr? newunit, expr? filename, expr? status, expr? form, expr? access, expr? iostat, expr? iomsg, expr? action, expr? delim, expr? recl, expr? position, expr? blank, expr? encoding, expr? sign, expr? decimal, expr? round, expr? pad, expr? asynchronous, expr? convert)
    | FileClose(int label, expr? unit, expr? iostat, expr? iomsg, expr? err, expr? status)
    | FileRead(int label, expr? unit, expr? fmt, expr? iomsg, expr? iostat, expr? advance, expr? size, expr? id, expr? pos, expr* values, stmt? overloaded, bool is_formatted, symbol? nml, expr? rec, expr? pad, expr? decimal)
    | FileBackspace(int label, expr? unit, expr? iostat, expr? iomsg, expr? err)
    | FileRewind(int label, expr? unit, expr? iostat, expr? err, expr? iomsg)
    | FileEndfile(int label, expr? unit, expr? iostat, expr? iomsg, expr? err)
    | FileInquire(int label, expr? unit, expr? file, expr? iostat, expr? err, expr? exist, expr? opened, expr? number, expr? named, expr? name, expr? access, expr? sequential, expr? direct, expr? form, expr? formatted, expr? unformatted, expr? recl, expr? nextrec, expr? blank, expr? position, expr? action, expr? read, expr? write, expr? readwrite, expr? delim, expr? pad, expr? flen, expr? blocksize, expr? convert, expr? carriagecontrol, expr? size, expr? pos, expr? iolength, expr* iolength_vars, expr? decimal, expr? sign, expr? encoding, expr? stream, expr? iomsg, expr? round, expr? pending, expr? asynchronous)
    | FileWrite(int label, expr? unit, expr? iomsg, expr? iostat, expr? id, expr* values, expr? separator, expr? end, stmt? overloaded, bool is_formatted, symbol? nml, expr? rec, expr? pos, expr? asynchronous, expr? decimal)
    | Return()
    | Select(identifier? name, expr test, case_stmt* body, stmt* default, bool enable_fall_through)
    | Stop(expr? code)
    | Assert(expr test, expr? msg)
    | SubroutineCall(symbol name, symbol? original_name, call_arg* args, expr? dt, bool strict_bounds_checking)
    | IntrinsicImpureSubroutine(int sub_intrinsic_id, expr* args, int overload_id)
    | Where(expr test, stmt* body, stmt* orelse)
    | WhileLoop(identifier? name, expr test, stmt* body, stmt* orelse)
    | Nullify(expr* vars)
    | Flush(int label, expr unit, expr? err, expr? iomsg, expr? iostat)
    | SyncAll(expr? stat, expr? errmsg)
    | SyncImages(expr? image_set, expr? stat, expr? errmsg)
    | SyncMemory(expr? stat, expr? errmsg)
    | SyncTeam(expr team, expr? stat, expr? errmsg)
    | FormTeam(expr team_number, expr team, expr? new_index, expr? stat, expr? errmsg)
    | ChangeTeam(expr team, expr? stat, expr? errmsg, stmt* body, expr? end_stat, expr? end_errmsg)
    | ListAppend(expr a, expr ele)
    | AssociateBlockCall(symbol m)
    | SelectType(expr selector, identifier? assoc_name, type_stmt* body, stmt* default)
    | SelectRank(identifier? name, expr selector, rank_stmt* body, stmt* default)
    | CPtrToPointer(expr cptr, expr ptr, expr? shape, expr? lower_bounds)
    | BlockCall(int label, symbol m)
    | SetInsert(expr a, expr ele)
    | SetRemove(expr a, expr ele)
    | ListInsert(expr a, expr pos, expr ele)
    | ListRemove(expr a, expr ele)
    | ListClear(expr a)
    | DictInsert(expr a, expr key, expr value)
    | DictClear(expr a)
    | SetClear(expr a)
    | Expr(expr expression)
    -- When overwritten_if[i] is true at the launch, the kernel assigns every
    -- element of the array overwritten[i], an actual argument of the launch,
    -- before it reads any of them: what the host holds there need not reach
    -- the device.
    | GpuKernelLaunch(symbol kernel, expr thread_count, expr block_size, call_arg* args, symbol? component_fit, gpu_scratch_buffer* scratch, expr? stop_status, stmt* stop_replay, expr* overwritten, expr* overwritten_if)
    | GpuSync()
    | GpuLaneBarrier()
    | GpuDiscard(expr* vars)
    -- Makes the Reference member `reference` (a StructInstanceMember of a
    -- frame object) refer to `variable`, a designator whose type is the
    -- referenced type: a Var, or a StructInstanceMember of a Reference member
    -- (to pass a reference on to the frame of a nested host). Only the
    -- address is stored: nothing is copied.
    | BindReference(expr reference, expr variable)

expr
    = IfExp(expr test, expr body, expr orelse, ttype type, expr? value)
    | ComplexConstructor(expr re, expr im, ttype type, expr? value)
    | NamedExpr(expr target, expr value, ttype type)
    | FunctionCall(symbol name, symbol? original_name, call_arg* args, ttype type, expr? value, expr? dt)
    | IntrinsicElementalFunction(int intrinsic_id, expr* args, int overload_id, ttype? type, expr? value)
    | IntrinsicArrayFunction(int arr_intrinsic_id, expr* args, int overload_id, ttype? type, expr? value)
    | IntrinsicImpureFunction(int impure_intrinsic_id, expr* args, int overload_id, ttype? type, expr? value)
    | TypeInquiry(int inquiry_id, ttype arg_type, expr? arg, ttype type, expr value)
    | StructConstructor(symbol dt_sym, call_arg* args, ttype type, expr? value)
    | StructConstant(symbol dt_sym, call_arg* args, ttype type)
    | EnumConstructor(symbol dt_sym, expr* args, ttype type, expr? value)
    | UnionConstructor(symbol dt_sym, expr* args, ttype type, expr? value)
    | ImpliedDoLoop(expr* values, expr var, expr start, expr end, expr? increment, ttype type, expr? value)
    | IntegerConstant(int n, ttype type, integerboz intboz_type)
    | IntegerBitNot(expr arg, ttype type, expr? value)
    | IntegerUnaryMinus(expr arg, ttype type, expr? value)
    | IntegerCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | IntegerBinOp(expr left, binop op, expr right, ttype type, expr? value)
    | UnsignedIntegerConstant(int n, ttype type)
    | UnsignedIntegerUnaryMinus(expr arg, ttype type, expr? value)
    | UnsignedIntegerBitNot(expr arg, ttype type, expr? value)
    | UnsignedIntegerCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | UnsignedIntegerBinOp(expr left, binop op, expr right, ttype type, expr? value)
    | RealConstant(float r, ttype type)
    | RealUnaryMinus(expr arg, ttype type, expr? value)
    | RealCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | RealBinOp(expr left, binop op, expr right, ttype type, expr? value)
    | RealCopySign(expr target, expr source, ttype type, expr? value)
    | ComplexConstant(float re, float im, ttype type)
    | ComplexUnaryMinus(expr arg, ttype type, expr? value)
    | ComplexCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | ComplexBinOp(expr left, binop op, expr right, ttype type, expr? value)
    | LogicalConstant(bool value, ttype type)
    | LogicalNot(expr arg, ttype type, expr? value)
    | LogicalCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | LogicalBinOp(expr left, logicalbinop op, expr right, ttype type, expr? value)
    | ListConstant(expr* args, ttype type)
    | ListLen(expr arg, ttype type, expr? value)
    | ListConcat(expr left, expr right, ttype type, expr? value)
    | ListCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | ListCount(expr arg, expr ele, ttype type, expr? value)
    | ListContains(expr left, expr right, ttype type, expr? value)
    | SetConstant(expr* elements, ttype type)
    | SetLen(expr arg, ttype type, expr? value)
    | TupleConstant(expr* elements, ttype type)
    | TupleLen(expr arg, ttype type, expr value)
    | TupleCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | TupleConcat(expr left, expr right, ttype type, expr? value)
    | TupleContains(expr left, expr right, ttype type, expr? value)
    | StringConstant(string s, ttype type)
    | StringConcat(expr left, expr right, ttype type, expr? value)
    | StringRepeat(expr left, expr right, ttype type, expr? value)
    | StringLen(expr arg, ttype type, expr? value)
    | StringItem(expr arg, expr idx, ttype type, expr? value)
    | CompilerOptions(string compiler_options_str, ttype type)
    | StringSection(expr arg, expr? start, expr? end, expr? step, ttype type, expr? value)
    | StringCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | StringContains(expr substr, expr str, ttype type, expr? value)
    | StringOrd(expr arg, ttype type, expr? value)
    | StringChr(expr arg, ttype type, expr? value)
    | StringFormat(expr? fmt, expr* args, string_format_kind kind, dtio_binding* dtio_bindings, expr? dtio_unit, ttype type, expr? value)
    | StringPhysicalCast(expr arg, string_physical_type old, string_physical_type new, ttype type, expr? value)
    | CPtrCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | SymbolicCompare(expr left, cmpop op, expr right, ttype type, expr? value)
    | DictConstant(expr* keys, expr* values, ttype type)
    | DictLen(expr arg, ttype type, expr? value)
    | Var(symbol v)
    | FunctionParam(int param_number, ttype type, expr? value)
    | ArrayConstructor(expr* args, ttype type, expr? value, arraystorage storage_format, expr? struct_var)
    | ArrayConstant(int n_data, void data, ttype type, arraystorage storage_format)
    | ArrayItem(expr v, array_index* args, ttype type, arraystorage storage_format, expr? value, bool in_bounds)
    | ArraySection(expr v, array_index* args, ttype type, expr? value)
    | CoarrayRef(expr var, coarray_index* coindices, ttype type, expr? value)
    | ArraySize(expr v, expr? dim, ttype type, expr? value)
    | ArrayRank(expr v, ttype type, expr? value)
    | ArrayBound(expr v, expr? dim, ttype type, arraybound bound, expr? value)
    | ArrayTranspose(expr matrix, ttype type, expr? value)
    | ArrayPack(expr array, expr mask, expr? vector, ttype type, expr? value)
    | ArrayReshape(expr array, expr shape, expr? pad, expr? order, ttype type, expr? value)
    | ArrayBroadcast(expr array, expr shape, ttype type, expr? value)
    | BitCast(expr source, expr mold, expr? size, ttype type, expr? value)
    | FunctionPointerCast(expr arg, symbol? to, ttype type, expr? value)
    | StructInstanceMember(expr v, symbol m, ttype type, expr? value)
    | StructStaticMember(expr v, symbol m, ttype type, expr? value)
    | EnumStaticMember(expr v, symbol m, ttype type, expr? value)
    | UnionInstanceMember(expr v, symbol m, ttype type, expr? value)
    | EnumName(expr v, ttype enum_type, ttype type, expr? value)
    | EnumValue(expr v, ttype enum_type, ttype type, expr? value)
    | OverloadedCompare(expr left, cmpop op, expr right, ttype type, expr? value, expr overloaded)
    | OverloadedBinOp(expr left, binop op, expr right, ttype type, expr? value, expr overloaded)
    | OverloadedBoolOp(expr left, logicalbinop op, expr right, ttype type, expr? value, expr overloaded)
    | OverloadedUnaryMinus(expr arg, ttype type, expr? value, expr overloaded)
    | OverloadedStringConcat(expr left, expr right, ttype type, expr? value, expr overloaded)
    | Cast(expr arg, cast_kind kind, ttype type, expr? value, expr? dest)
    | ArrayPhysicalCast(expr arg, array_physical_type old, array_physical_type new, ttype type, expr? value)
    | ComplexRe(expr arg, ttype type, expr? value)
    | ComplexIm(expr arg, ttype type, expr? value)
    | DictItem(expr a, expr key, expr? default, ttype type, expr? value)
    | CLoc(expr arg, ttype type, expr? value)
    | PointerToCPtr(expr arg, ttype type, expr? value)
    | GetPointer(expr arg, ttype type, expr? value)
    | ListItem(expr a, expr pos, ttype type, expr? value)
    | TupleItem(expr a, expr pos, ttype type, expr? value)
    | ListSection(expr a, array_index section, ttype type, expr? value)
    | ListRepeat(expr left, expr right, ttype type, expr? value)
    | DictPop(expr a, expr key, ttype type, expr? value)
    | SetPop(expr a, ttype type, expr? value)
    | SetContains(expr left, expr right, ttype type, expr? value)
    | DictContains(expr left, expr right, ttype type, expr? value)
    | IntegerBitLen(expr a, ttype type, expr? value)
    | Ichar(expr arg, ttype type, expr? value)
    | Iachar(expr arg, ttype type, expr? value)
    | SizeOfType(ttype arg, ttype type, expr? value)
    | PointerNullConstant(ttype type, expr? var_expr)
    | PointerAssociated(expr ptr, expr? tgt, ttype type, expr? value)
    | RealSqrt(expr arg, ttype type, expr? value)
    | ArrayIsContiguous(expr array, ttype type, expr? value)
    | GpuThreadIndex(int dim, ttype type, expr? value)
    | GpuBlockIndex(int dim, ttype type, expr? value)
    | GpuBlockSize(int dim, ttype type, expr? value)
    | GpuAtomicFetchAdd(expr target, expr increment, ttype type, expr? value)
    | GpuLaneIndex(ttype type, expr? value)
    | GpuLaneBroadcast(expr arg, ttype type, expr? value)

ttype
    = Integer(int kind)
    | UnsignedInteger(int kind)
    | Real(int kind)
    | Complex(int kind)
    | String(int kind, expr? len, string_length_kind len_kind, string_physical_type physical_type)
    | Logical(int kind)
    | Set(ttype type)
    | List(ttype type)
    | Tuple(ttype* type)
    | StructType(ttype* data_member_types, ttype* member_function_types, bool is_cstruct, bool is_unlimited_polymorphic)
    | EnumType(symbol enum_type)
    | UnionType(ttype* data_member_types)
    | Dict(ttype key_type, ttype value_type)
    | Pointer(ttype type)
    | Allocatable(ttype type)
    | CPtr(cptr_kind kind)
    | SymbolicExpression()
    | TypeParameter(identifier param, deferred_type_attr deferred_attr, bool is_class)
    | Array(ttype type, dimension* dims, array_physical_type physical_type, memory_space memory_space)
    | FunctionType(ttype* arg_types, ttype? return_var_type, abi abi, deftype deftype, string? bindc_name, bool elemental, bool pure, bool module, bool inline, bool static, symbol* restrictions, bool is_restriction, exec_space exec_space)
    -- The address of a variable of type `type`, held by a member of a frame
    -- created by the nested_vars pass. A StructInstanceMember of such a member
    -- designates the variable itself and has type `type`. It is never
    -- allocated, deallocated, finalized, copied or default-initialized with
    -- the object that contains it.
    | Reference(ttype type)

cast_kind = RealToInteger | IntegerToReal | LogicalToReal | RealToReal | IntegerToInteger | RealToComplex | IntegerToComplex | IntegerToLogical | RealToLogical | StringToLogical | StringToInteger | StringToList | ComplexToLogical | ComplexToComplex | ComplexToReal | ComplexToInteger | LogicalToInteger | LogicalToLogical | RealToString | IntegerToString | LogicalToString | StringToString | UnsignedIntegerToInteger | UnsignedIntegerToUnsignedInteger | UnsignedIntegerToReal | UnsignedIntegerToLogical | IntegerToUnsignedInteger | RealToUnsignedInteger | CPtrToUnsignedInteger | UnsignedIntegerToCPtr | IntegerToSymbolicExpression | ListToArray | StringToArray | PointerToInteger | ClassToStruct | ClassToClass | ClassToIntrinsic
-- The effective deferred-type-attr (F2028 draft J3/26-007r1 R1617) of a
-- deferred type argument of a template or a requirement. `Abstract`
-- subsumes `Extensible`, because a deferred type with the ABSTRACT
-- attribute implicitly has the EXTENSIBLE attribute (16.4.1.2 paragraph 2);
-- `NonExtensible` is a plain `deferred type ::` with no attribute.
deferred_type_attr = NonExtensible | Extensible | Abstract
cptr_kind = CPointer | CFunPointer | CPtrUnspecified
-- Caller-provided storage for a function result lowered to a dummy argument.
-- A Variable of HostAssociated storage has no storage of its own: it denotes
-- the variable designated by its symbolic_value, a StructInstanceMember of a
-- member of the frame dummy argument of its procedure, bound on entry before
-- any other declaration of the procedure is evaluated, like a dummy argument
-- associated by reference. Its type is that of the designated variable.
storage_type = Default | Save | Parameter | Threadprivate | ResultArgument | HostAssociated
-- How a CommonBlock view provides the block's storage: a Tentative view
-- gives no initial value, an Initialized one gives initial values (even all
-- zero ones) through its variables, and an External one (in a module read
-- from a module file) only refers to storage defined elsewhere.
common_block_role = Tentative | Initialized | External
access = Public | Private
intent = Local | In | Out | InOut | ReturnVar | Unspecified
deftype = Implementation | Interface | ImplicitInterface
presence = Required | Optional
pass_attr = NotMethod | Pass | NoPass
abi = Source | LFortranModule | GFortranModule | BindC | BindPython | BindJS | ExternalUndefined | Intrinsic
exec_space = Host | Device | HostDevice | Kernel
exec_target = ExecAuto | ExecSerial | ExecHostThreads | ExecDevice
memory_space = Global | Shared | Constant | Thread
dimension = (expr? start, expr? length)
codimension = (expr? start, expr? end, codimension_type end_star)
codimension_type = CodimensionExpr | CodimensionStar
-- The first storage unit of `designator`, a designator of `variable`, is the
-- first storage unit of `anchor`, a designator of a member of the block or
-- of the variable of an earlier association.
common_association = (symbol variable, expr designator, expr anchor)
alloc_arg = (expr a, dimension* dims, codimension* codims, expr? len_expr, symbol? sym_subclass, ttype? type)
attribute = Attribute(identifier name, attribute_arg *args)
attribute_arg = (identifier arg)
call_arg = (expr? value)
-- The defined output procedure `procedure` formats the items of declared type
-- `type_declaration` (class(T) if `polymorphic`) of a StringFormat; the
-- runtime formatter calls it through `callback`.
dtio_binding = (symbol type_declaration, bool polymorphic, symbol procedure, symbol? callback)
gpu_argument_kind = GpuArray | GpuStruct | GpuClass | GpuMemberData | GpuMemberOffsets | GpuMemberSizes | GpuScalar | GpuArrayExtent | GpuPackedOffset
-- `noalias`: no other buffer of any launch of the kernel shares storage with
-- this buffer where either of them is written (gpu_kernel_abi.cpp).
gpu_kernel_argument = (symbol variable, symbol? member, ttype type, gpu_argument_kind kind, int argument_index, int dimension, bool written, bool noalias)
gpu_workspace_dimension = (expr extent, symbol? parameter)
gpu_workspace = (symbol variable, gpu_workspace_dimension* dims, int buffer_index, int element_size)
gpu_scratch_buffer = (int argument_index, expr size, expr? read_back)
gpu_kernel_layout = (gpu_kernel_argument* buffers, gpu_kernel_argument* scalars, gpu_workspace* workspaces, bool packed, int source_argument_count, symbol* device_functions, symbol? lanes)
reduction_expr = (reduction_op op, expr arg)
tbind = Bind(string lang, string name)
-- A comparison, by DebugCheckArrayBounds, of the extents of two of its
-- arrays in dimension `dim`. An array is numbered 0 for `target` and i for
-- the i-th element of `components`; `left_extent` and `right_extent` are the
-- integer(4) extents of arrays `left` and `right`.
array_extent_check = (int left, int right, int dim, expr left_extent, expr right_extent)
array_index = (expr? left, expr? right, expr? step)
coarray_index = (expr? index, codimension_type star)
do_loop_head = (expr? v, expr? start, expr? end, expr? increment)
case_stmt = CaseStmt(expr* test, stmt* body, bool fall_through) | CaseStmt_Range(expr? start, expr? end, stmt* body)
type_stmt = TypeStmtName(symbol sym, stmt* body) | ClassStmt(symbol sym, stmt* body) | TypeStmtType(ttype type, stmt* body)
rank_stmt = RankExpr(expr rank, stmt* body)
enumtype = IntegerConsecutiveFromZero | IntegerUnique | IntegerNotUnique | NonInteger
require_instantiation = Require(identifier name, identifier* args)
pointer_bounds_form = NoPointerBounds | PointerBoundsSpec | PointerBoundsRemapping
array_physical_type = DescriptorArray | PointerArray | UnboundedPointerArray | FixedSizeArray | StringArraySinglePointer | SIMDArray | AssumedRankArray
string_physical_type = DescriptorString | CChar
string_length_kind = AssumedLength | DeferredLength | ExpressionLength | ImplicitLength
binop = Add | Sub | Mul | Div | Pow | BitAnd | BitOr | BitXor | BitLShift | BitRShift | LBitRShift
reduction_op = ReduceAdd | ReduceSub | ReduceMul | ReduceMIN | ReduceMAX | ReduceIAND | ReduceIOR | ReduceIEOR
logicalbinop = And | Or | Xor | NEqv | Eqv
cmpop = Eq | NotEq | Lt | LtE | Gt | GtE
integerboz = Binary | Hex | Octal | Decimal
arraybound = LBound | UBound
arraystorage = RowMajor | ColMajor
string_format_kind = FormatFortran | FormatFortranLeadingBlank | FormatC | FormatPythonPercent | FormatPythonFString | FormatPythonFormat

omp_region_type = Parallel | Do | ParallelDo | Sections | Section | ParallelSections | Critical | Atomic | Barrier | Single | Master | Task | Taskwait | Taskloop | Simd | Teams | Distribute | TeamsDistribute | DistributeParallelDo | Target | TargetData
omp_clause
  = OMPPrivate(expr* vars)
  | OMPShared(expr* vars)
  | OMPFirstPrivate(expr* vars)
  | OMPLastPrivate(expr* vars)
  | OMPReduction(reduction_op operator, expr* vars)
  | OMPCollapse(expr count)
  | OMPIf(expr condition)
  | OMPNumThreads(expr num_threads)
  | OMPSchedule(schedule_type kind, expr? chunk_size)
  | OMPNowait()
  | OMPNumTeams(expr num_teams)
  | OMPThreadLimit(expr thread_limit)
  | OMPDevice(expr device)
  | OMPMap(map_type type, expr* vars)
  | OMPIndependent()
  | OMPTargetRequested()
  | OMPCriticalName(identifier name)
  -- When `condition` holds on entry to a parallel region assigned to the
  -- device, its iterations together assign every element of `array` before
  -- any of them reads it: what the host holds there need not reach the
  -- device. A pass that rewrites the loop into a form the offload cannot
  -- read this from records it from the loop as it was; a pass that changes
  -- which iterations the region runs, or takes it off the device, drops it.
  | OMPOverwrite(expr array, expr condition)

map_type 
    = To | From | ToFrom | Alloc | Release | Delete
    
schedule_type
    = Static | Dynamic | Guided | Auto | Runtime

}
