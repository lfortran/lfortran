#include <stdint.h>

// The lanes of an iteration are consecutive threads of a warp, or,
// with more than 32 of them, all the threads of a block.
template <int op, typename T>
__device__ inline T __lfortran_lane_combine(T v, T w) {
    return op == 0 ? v + w : op == 1 ? v * w
        : op == 2 ? (w < v ? w : v) : (w > v ? w : v);
}

// The lanes are the warps of a block: each combines its own lanes,
// and every lane then folds the partial results of the warps in the
// same order.
template <int op, typename T>
__device__ __noinline__ T __lfortran_block_reduce(T v, int lanes) {
    #pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1) {
        v = __lfortran_lane_combine<op>(v,
            __shfl_xor_sync(0xffffffffu, v, offset, 32));
    }
    __shared__ T partial[32];
    if ((threadIdx.x & 31u) == 0) partial[threadIdx.x >> 5] = v;
    __syncthreads();
    T r = partial[0];
    for (int i = 1; i < (lanes >> 5); i++) {
        r = __lfortran_lane_combine<op>(r, partial[i]);
    }
    __syncthreads();
    return r;
}

// The combination of what the `lanes` lanes of an iteration hold,
// in every lane: 0 adds, 1 multiplies, 2 takes the smallest, 3 the
// largest. With one lane, the lane's own value.
template <int op, typename T>
__device__ inline T __lfortran_lane_reduce(T v, int lanes, unsigned mask) {
    if (lanes == 32) {
        // A whole warp, named as a constant: with the mask in a
        // register nvcc tests every shuffle for diverged lanes.
        #pragma unroll
        for (int offset = 16; offset > 0; offset >>= 1) {
            v = __lfortran_lane_combine<op>(v,
                __shfl_xor_sync(0xffffffffu, v, offset, 32));
        }
        return v;
    }
    if (lanes == 16) {
        // The common sizes, with the shuffles unrolled.
        #pragma unroll
        for (int offset = 16; offset > 0; offset >>= 1) {
            if (offset < lanes) {
                v = __lfortran_lane_combine<op>(v,
                    __shfl_xor_sync(mask, v, offset, lanes));
            }
        }
        return v;
    }
    for (int offset = lanes >> 1; offset > 0; offset >>= 1) {
        v = __lfortran_lane_combine<op>(v,
            __shfl_xor_sync(mask, v, offset, lanes));
    }
    return v;
}

// For a kernel whose iterations may have the lanes of a block. Its
// barriers keep the other kernels from reordering their loads, so
// the others do not call these.
template <int op, typename T>
__device__ inline T __lfortran_lane_reduce_block(T v, int lanes, unsigned mask) {
    if (lanes > 32) return __lfortran_block_reduce<op>(v, lanes);
    return __lfortran_lane_reduce<op>(v, lanes, mask);
}

__device__ __noinline__ void __lfortran_block_barrier() {
    __syncthreads();
}

// Waits for the other lanes of the iteration.
__device__ inline void __lfortran_lane_barrier(int lanes, unsigned mask) {
    if (lanes > 1) __syncwarp(mask);
}

__device__ inline void __lfortran_lane_barrier_block(int lanes, unsigned mask) {
    if (lanes > 32) __lfortran_block_barrier();
    else if (lanes > 1) __syncwarp(mask);
}

template <typename T>
__device__ __noinline__ T __lfortran_block_broadcast(T v, int lanes) {
    __shared__ T first;
    if ((threadIdx.x % (unsigned)lanes) == 0) first = v;
    __syncthreads();
    T r = first;
    __syncthreads();
    return r;
}

// The value of the first lane of the iteration, in every lane.
template <typename T>
__device__ inline T __lfortran_lane_broadcast(T v, int lanes, unsigned mask) {
    return lanes > 1 ? __shfl_sync(mask, v, 0, lanes) : v;
}

template <typename T>
__device__ inline T __lfortran_lane_broadcast_block(T v, int lanes, unsigned mask) {
    if (lanes > 32) return __lfortran_block_broadcast(v, lanes);
    return __lfortran_lane_broadcast(v, lanes, mask);
}

#include <cooperative_groups.h>
#include <cooperative_groups/reduce.h>

// The operation of a reduction of elements of arrays: 0 adds, 1
// multiplies, 2 takes the smaller, 3 the larger.
template <int op, typename T>
__device__ inline T __lfortran_reduce_op(T v, T w) {
    return op == 0 ? v + w : op == 1 ? v * w
        : op == 2 ? (w < v ? w : v) : (w > v ? w : v);
}

// Whether this is the last of the `units` arrivals at the counter,
// the first element of the scratch buffer, which it then leaves
// zero for the next launch.
// What a unit wrote before it arrives is seen by the last one
// after it arrives: the add releases and acquires.
__device__ inline bool __lfortran_reduce_arrive(void *scratch,
        long long units) {
    unsigned int *counter = (unsigned int*)scratch;
    unsigned int done;
#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 700
    asm volatile("atom.add.acq_rel.gpu.u32 %0, [%1], 1;"
        : "=r"(done) : "l"(counter) : "memory");
#else
    __threadfence();
    done = atomicAdd(counter, 1u);
    __threadfence();
#endif
    if ((long long)done < units - 1) return false;
    *counter = 0u;
    return true;
}

// `v` combined over the 32 threads of a warp, in every one.
template <int op, typename T>
__device__ inline T __lfortran_reduce_warp(T v) {
    #pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1) {
        v = __lfortran_reduce_op<op>(v,
            __shfl_xor_sync(0xffffffffu, v, offset, 32));
    }
    return v;
}

// The target combined with `v` by an atomic update, for the
// operations whose result does not depend on the order: an integer
// sum, and the larger or the smaller of integers (natively) or of
// reals (by compare and swap of their bits).
template <int op>
__device__ inline void __lfortran_reduce_atomic(int *p, int v) {
    if (op == 0) atomicAdd(p, v);
    else if (op == 2) atomicMin(p, v);
    else atomicMax(p, v);
}

template <int op>
__device__ inline void __lfortran_reduce_atomic(long long *p, long long v) {
    if (op == 0) atomicAdd((unsigned long long*)p, (unsigned long long)v);
    else if (op == 2) atomicMin(p, v);
    else atomicMax(p, v);
}

template <int op>
__device__ inline void __lfortran_reduce_atomic(long *p, long v) {
    __lfortran_reduce_atomic<op>((long long*)p, (long long)v);
}

template <int op, typename T, typename U>
__device__ inline void __lfortran_reduce_atomic_bits(T *p, T v) {
    U *q = (U*)p;
    U old = *(volatile U*)q, assumed;
    do {
        assumed = old;
        T current;
        __builtin_memcpy(&current, &assumed, sizeof(T));
        T next = __lfortran_reduce_op<op>(current, v);
        U bits;
        __builtin_memcpy(&bits, &next, sizeof(T));
        if (bits == assumed) return;
        old = atomicCAS(q, assumed, bits);
    } while (old != assumed);
}

template <int op>
__device__ inline void __lfortran_reduce_atomic(float *p, float v) {
    __lfortran_reduce_atomic_bits<op, float, unsigned int>(p, v);
}

template <int op>
__device__ inline void __lfortran_reduce_atomic(double *p, double v) {
    __lfortran_reduce_atomic_bits<op, double, unsigned long long>(p, v);
}

// The threads of a warp that call it together combine their `v`, and
// the first of them updates the target: one atomic update per warp.
template <int op, typename T>
__device__ inline void __lfortran_reduce_atomic_group(T *p, T v) {
    namespace cg = cooperative_groups;
    cg::coalesced_group g = cg::coalesced_threads();
    T r;
    if (op == 0) r = cg::reduce(g, v, cg::plus<T>());
    else if (op == 2) r = cg::reduce(g, v, cg::less<T>());
    else r = cg::reduce(g, v, cg::greater<T>());
    if (g.thread_rank() == 0) __lfortran_reduce_atomic<op>(p, r);
}

// `v` combined over the threads of the block, in every one: each warp
// combines its own, and the warps' meet in shared memory in their
// order.
template <int op, typename T>
__device__ __noinline__ T __lfortran_reduce_block(T v) {
    v = __lfortran_reduce_warp<op>(v);
    __shared__ T partial[32];
    if ((threadIdx.x & 31u) == 0) partial[threadIdx.x >> 5] = v;
    __syncthreads();
    T r = partial[0];
    for (unsigned i = 1; i < (blockDim.x >> 5); i++) {
        r = __lfortran_reduce_op<op>(r, partial[i]);
    }
    __syncthreads();
    return r;
}

