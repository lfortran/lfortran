#include <stdint.h>

// The lanes of an iteration are consecutive threads of a warp, or,
// with more than 32 of them, all the threads of a block.
template <int op, typename T>
__device__ inline T __lfortran_lane_combine(T v, T w) {
    return op == 0 ? v + w : op == 1 ? v * w
        : op == 2 ? (w < v ? w : v) : (w > v ? w : v);
}

// The lanes are the warps of a block: each combines its own lanes,
// and every lane then folds the partial results of the warps in the
// same order.
template <int op, typename T>
__device__ __noinline__ T __lfortran_block_reduce(T v, int lanes) {
    #pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1) {
        v = __lfortran_lane_combine<op>(v,
            __shfl_xor_sync(0xffffffffu, v, offset, 32));
    }
    __shared__ T partial[32];
    if ((threadIdx.x & 31u) == 0) partial[threadIdx.x >> 5] = v;
    __syncthreads();
    T r = partial[0];
    for (int i = 1; i < (lanes >> 5); i++) {
        r = __lfortran_lane_combine<op>(r, partial[i]);
    }
    __syncthreads();
    return r;
}

// The combination of what the `lanes` lanes of an iteration hold,
// in every lane: 0 adds, 1 multiplies, 2 takes the smallest, 3 the
// largest. With one lane, the lane's own value.
template <int op, typename T>
__device__ inline T __lfortran_lane_reduce(T v, int lanes, unsigned mask) {
    if (lanes == 32 || lanes == 16) {
        // The common sizes, with the shuffles unrolled.
        #pragma unroll
        for (int offset = 16; offset > 0; offset >>= 1) {
            if (offset < lanes) {
                v = __lfortran_lane_combine<op>(v,
                    __shfl_xor_sync(mask, v, offset, lanes));
            }
        }
        return v;
    }
    for (int offset = lanes >> 1; offset > 0; offset >>= 1) {
        v = __lfortran_lane_combine<op>(v,
            __shfl_xor_sync(mask, v, offset, lanes));
    }
    return v;
}

// For a kernel whose iterations may have the lanes of a block. Its
// barriers keep the other kernels from reordering their loads, so
// the others do not call these.
template <int op, typename T>
__device__ inline T __lfortran_lane_reduce_block(T v, int lanes, unsigned mask) {
    if (lanes > 32) return __lfortran_block_reduce<op>(v, lanes);
    return __lfortran_lane_reduce<op>(v, lanes, mask);
}

__device__ __noinline__ void __lfortran_block_barrier() {
    __syncthreads();
}

// Waits for the other lanes of the iteration.
__device__ inline void __lfortran_lane_barrier(int lanes, unsigned mask) {
    if (lanes > 1) __syncwarp(mask);
}

__device__ inline void __lfortran_lane_barrier_block(int lanes, unsigned mask) {
    if (lanes > 32) __lfortran_block_barrier();
    else if (lanes > 1) __syncwarp(mask);
}

template <typename T>
__device__ __noinline__ T __lfortran_block_broadcast(T v, int lanes) {
    __shared__ T first;
    if ((threadIdx.x % (unsigned)lanes) == 0) first = v;
    __syncthreads();
    T r = first;
    __syncthreads();
    return r;
}

// The value of the first lane of the iteration, in every lane.
template <typename T>
__device__ inline T __lfortran_lane_broadcast(T v, int lanes, unsigned mask) {
    return lanes > 1 ? __shfl_sync(mask, v, 0, lanes) : v;
}

template <typename T>
__device__ inline T __lfortran_lane_broadcast_block(T v, int lanes, unsigned mask) {
    if (lanes > 32) return __lfortran_block_broadcast(v, lanes);
    return __lfortran_lane_broadcast(v, lanes, mask);
}

// The 16 bytes that start at `p`: read at once when `ok` says `p` is a
// multiple of 16, element by element, put together, when it is not.
// The elements are taken out of the 16 bytes, so that the two ways
// meet before the elements are separated.
template <typename T>
__device__ __forceinline__ uint4 __lfortran_wide_vector(bool ok, const T* p) {
    if (ok) return *reinterpret_cast<const uint4*>(p);
    T t[16 / sizeof(T)];
    #pragma unroll
    for (int i = 0; i < 16 / (int)sizeof(T); i++) t[i] = p[i];
    uint4 v;
    __builtin_memcpy(&v, t, 16);
    return v;
}

template <typename T>
__device__ __forceinline__ void __lfortran_wide_load(bool ok, const T* p, T &a, T &b) {
    uint4 v = __lfortran_wide_vector(ok, p);
    const T* e = reinterpret_cast<const T*>(&v);
    a = e[0]; b = e[1];
}

template <typename T>
__device__ __forceinline__ void __lfortran_wide_load(bool ok, const T* p, T &a, T &b, T &c, T &d) {
    uint4 v = __lfortran_wide_vector(ok, p);
    const T* e = reinterpret_cast<const T*>(&v);
    a = e[0]; b = e[1]; c = e[2]; d = e[3];
}

template <typename T>
__device__ __forceinline__ void __lfortran_wide_load(bool ok, const T* p, T &a0, T &a1, T &a2, T &a3, T &a4, T &a5, T &a6, T &a7) {
    uint4 v = __lfortran_wide_vector(ok, p);
    const T* e = reinterpret_cast<const T*>(&v);
    a0 = e[0]; a1 = e[1]; a2 = e[2]; a3 = e[3]; a4 = e[4]; a5 = e[5]; a6 = e[6]; a7 = e[7];
