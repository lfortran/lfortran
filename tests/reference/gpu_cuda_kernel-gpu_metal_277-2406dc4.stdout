// For a kernel whose iterations may have the lanes of a block. Its
// barriers keep the other kernels from reordering their loads, so
// the others do not call these.
template <int op, typename T>
__device__ inline T __lfortran_lane_reduce_block(T v, int lanes, unsigned mask) {
    if (lanes > 32) return __lfortran_block_reduce<op>(v, lanes);
    return __lfortran_lane_reduce<op>(v, lanes, mask);
