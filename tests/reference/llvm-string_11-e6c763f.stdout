free_done:                                        ; preds = %free_nonnull, %else
  br label %ifcont

ifcont:                                           ; preds = %free_done, %then
  br label %return

return:                                           ; preds = %ifcont
  br label %FINALIZE_SYMTABLE_string_11

FINALIZE_SYMTABLE_string_11:                      ; preds = %return
  br label %Finalize_Variable_mystring

Finalize_Variable_mystring:                       ; preds = %FINALIZE_SYMTABLE_string_11
  %41 = getelementptr %string_descriptor, %string_descriptor* %mystring, i32 0, i32 0
  %42 = load i8*, i8** %41, align 8
