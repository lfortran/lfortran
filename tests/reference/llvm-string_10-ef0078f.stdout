  %132 = getelementptr %string_descriptor, %string_descriptor* %num, i32 0, i32 0
  %133 = load i8*, i8** %132, align 8
  call void @_lfortran_free_alloc(i8* %2, i8* %133)
  call void @_lfortran_internal_alloc_finalize()
  ret i32 0
}

