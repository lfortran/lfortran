; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

%string_descriptor = type <{ i8*, i64 }>
%complex_4 = type <{ float, float }>

@0 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info = private unnamed_addr constant [8 x i8] c"{R4,R4}\00", align 1
@1 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@2 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info.1 = private unnamed_addr constant [8 x i8] c"{R4,R4}\00", align 1
@3 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@4 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info.2 = private unnamed_addr constant [8 x i8] c"{R4,R4}\00", align 1
@5 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1

define i32 @main(i32 %0, i8** %1) {
.entry:
  %stringFormat_desc4 = alloca %string_descriptor, align 8
  %stringFormat_desc1 = alloca %string_descriptor, align 8
  %stringFormat_desc = alloca %string_descriptor, align 8
  %2 = call i8* @_lfortran_get_default_allocator()
  call void @_lpython_call_initial_functions(i32 %0, i8** %1)
  %x = alloca %complex_4, align 8
  store %complex_4 <{ float 3.000000e+00, float 4.000000e+00 }>, %complex_4* %x, align 1
  %3 = load %complex_4, %complex_4* %x, align 1
  %4 = extractvalue %complex_4 %3, 0
  %5 = extractvalue %complex_4 %3, 1
  %6 = fsub float %4, 4.000000e+00
  %7 = fsub float %5, 0.000000e+00
  %8 = insertvalue %complex_4 undef, float %6, 0
  %9 = insertvalue %complex_4 %8, float %7, 1
  store %complex_4 %9, %complex_4* %x, align 1
  %10 = load %complex_4, %complex_4* %x, align 1
  %11 = extractvalue %complex_4 %10, 0
  %12 = extractvalue %complex_4 %10, 1
  %13 = fsub float 4.000000e+00, %11
  %14 = fsub float 0.000000e+00, %12
  %15 = insertvalue %complex_4 undef, float %13, 0
  %16 = insertvalue %complex_4 %15, float %14, 1
  store %complex_4 %16, %complex_4* %x, align 1
  %17 = call i8* @llvm.stacksave()
  %18 = alloca i64, align 8
  %19 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, ...) @_lcompilers_string_format_fortran(i8* %2, i8* null, i64 0, i8* getelementptr inbounds ([8 x i8], [8 x i8]* @serialization_info, i32 0, i32 0), i64* %18, i32 0, i32 0, i32 0, i32 0, i32 0, %complex_4* %x)
  %20 = load i64, i64* %18, align 8
  call void @llvm.stackrestore(i8* %17)
  %21 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 0
  store i8* %19, i8** %21, align 8
  %22 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 1
  store i64 %20, i64* %22, align 8
  %23 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 0
  %24 = load i8*, i8** %23, align 8
  %25 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 1
  %26 = load i64, i64* %25, align 8
  %27 = trunc i64 %26 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @1, i32 0, i32 0), i8* %24, i32 %27, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @0, i32 0, i32 0), i32 1)
  %28 = icmp eq i8* %19, null
  br i1 %28, label %free_done, label %free_nonnull

free_nonnull:                                     ; preds = %.entry
  call void @_lfortran_free_alloc(i8* %2, i8* %19)
  br label %free_done

free_done:                                        ; preds = %free_nonnull, %.entry
  %29 = load %complex_4, %complex_4* %x, align 1
  %30 = extractvalue %complex_4 %29, 0
  %31 = extractvalue %complex_4 %29, 1
  %32 = fsub float 2.000000e+00, %30
  %33 = fsub float 0.000000e+00, %31
  %34 = insertvalue %complex_4 undef, float %32, 0
  %35 = insertvalue %complex_4 %34, float %33, 1
  store %complex_4 %35, %complex_4* %x, align 1
  %36 = call i8* @llvm.stacksave()
  %37 = alloca i64, align 8
  %38 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, ...) @_lcompilers_string_format_fortran(i8* %2, i8* null, i64 0, i8* getelementptr inbounds ([8 x i8], [8 x i8]* @serialization_info.1, i32 0, i32 0), i64* %37, i32 0, i32 0, i32 0, i32 0, i32 0, %complex_4* %x)
  %39 = load i64, i64* %37, align 8
  call void @llvm.stackrestore(i8* %36)
  %40 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc1, i32 0, i32 0
  store i8* %38, i8** %40, align 8
  %41 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc1, i32 0, i32 1
  store i64 %39, i64* %41, align 8
  %42 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc1, i32 0, i32 0
  %43 = load i8*, i8** %42, align 8
  %44 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc1, i32 0, i32 1
  %45 = load i64, i64* %44, align 8
  %46 = trunc i64 %45 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @3, i32 0, i32 0), i8* %43, i32 %46, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @2, i32 0, i32 0), i32 1)
  %47 = icmp eq i8* %38, null
  br i1 %47, label %free_done3, label %free_nonnull2

free_nonnull2:                                    ; preds = %free_done
  call void @_lfortran_free_alloc(i8* %2, i8* %38)
  br label %free_done3

free_done3:                                       ; preds = %free_nonnull2, %free_done
  %48 = load %complex_4, %complex_4* %x, align 1
  %49 = extractvalue %complex_4 %48, 0
  %50 = extractvalue %complex_4 %48, 1
  %51 = fsub float %49, 0.000000e+00
  %52 = fsub float %50, 3.000000e+00
  %53 = insertvalue %complex_4 undef, float %51, 0
  %54 = insertvalue %complex_4 %53, float %52, 1
  store %complex_4 %54, %complex_4* %x, align 1
  %55 = call i8* @llvm.stacksave()
  %56 = alloca i64, align 8
  %57 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, ...) @_lcompilers_string_format_fortran(i8* %2, i8* null, i64 0, i8* getelementptr inbounds ([8 x i8], [8 x i8]* @serialization_info.2, i32 0, i32 0), i64* %56, i32 0, i32 0, i32 0, i32 0, i32 0, %complex_4* %x)
  %58 = load i64, i64* %56, align 8
  call void @llvm.stackrestore(i8* %55)
  %59 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 0
  store i8* %57, i8** %59, align 8
  %60 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 1
  store i64 %58, i64* %60, align 8
  %61 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 0
  %62 = load i8*, i8** %61, align 8
  %63 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 1
  %64 = load i64, i64* %63, align 8
  %65 = trunc i64 %64 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @5, i32 0, i32 0), i8* %62, i32 %65, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @4, i32 0, i32 0), i32 1)
  %66 = icmp eq i8* %57, null
  br i1 %66, label %free_done6, label %free_nonnull5

free_nonnull5:                                    ; preds = %free_done3
  call void @_lfortran_free_alloc(i8* %2, i8* %57)
  br label %free_done6

free_done6:                                       ; preds = %free_nonnull5, %free_done3
  br label %return

return:                                           ; preds = %free_done6
  br label %FINALIZE_SYMTABLE_complex2

FINALIZE_SYMTABLE_complex2:                       ; preds = %return
  call void @_lfortran_internal_alloc_finalize()
  ret i32 0
}

declare void @_lpython_call_initial_functions(i32, i8**)

; Function Attrs: nounwind
declare i8* @llvm.stacksave() #0

declare i8* @_lcompilers_string_format_fortran(i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, ...)

declare i8* @_lfortran_get_default_allocator()

; Function Attrs: nounwind
declare void @llvm.stackrestore(i8*) #0

declare void @_lfortran_printf(i8*, i8*, i32, i8*, i32)

declare void @_lfortran_free_alloc(i8*, i8*)

declare void @_lfortran_internal_alloc_finalize()

attributes #0 = { nounwind }
