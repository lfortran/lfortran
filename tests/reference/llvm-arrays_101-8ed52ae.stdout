  %52 = icmp eq i32 %do_loop.iv.mem43, 1000
  br i1 %52, label %do_loop.end45, label %do_loop.body26

do_loop.end45:                                    ; preds = %do_loop.head42, %do_loop.cond25
  %53 = load float, float* %sum, align 4
  %54 = fsub float %53, 5.005000e+05
  %55 = call float @llvm.fabs.f32(float %54)
  %56 = fcmp ogt float %55, 0x3FB99999A0000000
  br i1 %56, label %then46, label %else47

then46:                                           ; preds = %do_loop.end45
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @5, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @4, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
