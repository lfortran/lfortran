; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

%string_descriptor = type { i8*, i64 }

@"ERROR STOP" = private unnamed_addr constant [11 x i8] c"ERROR STOP\00", align 1
@0 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@1 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@2 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@3 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@4 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@5 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@6 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@string_const_data = private constant [2 x i8] c"OK"
@string_const = private global %string_descriptor { i8* getelementptr inbounds ([2 x i8], [2 x i8]* @string_const_data, i32 0, i32 0), i64 2 }
@7 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1

define internal float @_lcompilers_real_i32(i32* %x) {
.entry:
  %_lcompilers_real_i32 = alloca float, align 4
  %0 = load i32, i32* %x, align 1
  %1 = sitofp i32 %0 to float
  store float %1, float* %_lcompilers_real_i32, align 4
  br label %return

return:                                           ; preds = %.entry
  br label %FINALIZE_SYMTABLE__lcompilers_real_i32

FINALIZE_SYMTABLE__lcompilers_real_i32:           ; preds = %return
  %2 = load float, float* %_lcompilers_real_i32, align 4
  ret float %2
}

define i32 @main(i32 %0, i8** %1) {
.entry:
  %2 = call i8* @_lfortran_get_default_allocator()
  %array_bound30 = alloca i32, align 4
  %array_bound26 = alloca i32, align 4
  %array_bound9 = alloca i32, align 4
  %array_bound5 = alloca i32, align 4
  %array_bound1 = alloca i32, align 4
  %array_bound = alloca i32, align 4
  call void @_lpython_call_initial_functions(i32 %0, i8** %1)
  %__do_loop_end = alloca i32, align 4
  %__do_loop_end1 = alloca i32, align 4
  %__libasr_index_0_ = alloca i32, align 4
  %__libasr_index_0_1 = alloca i32, align 4
  %i = alloca i32, align 4
  %3 = call i8* @_lfortran_get_default_allocator()
  %4 = call i8* @_lfortran_malloc_alloc(i8* %3, i64 8000)
  %5 = bitcast i8* %4 to [2000 x float]*
  %small_arr = alloca [100 x float], align 16
  %sum = alloca float, align 4
  br i1 true, label %then, label %else

then:                                             ; preds = %.entry
  store i32 100, i32* %array_bound, align 4
  br label %ifcont

else:                                             ; preds = %.entry
  br label %ifcont

ifcont:                                           ; preds = %else, %then
  %6 = load i32, i32* %array_bound, align 4
  store i32 %6, i32* %__do_loop_end, align 4
  br i1 true, label %then2, label %else3

then2:                                            ; preds = %ifcont
  store i32 1, i32* %array_bound1, align 4
  br label %ifcont4

else3:                                            ; preds = %ifcont
  br label %ifcont4

ifcont4:                                          ; preds = %else3, %then2
  %7 = load i32, i32* %array_bound1, align 4
  %8 = sub i32 %7, 1
  store i32 %8, i32* %__libasr_index_0_, align 4
  br label %loop.head

loop.head:                                        ; preds = %loop.body, %ifcont4
  %9 = load i32, i32* %__libasr_index_0_, align 4
  %10 = add i32 %9, 1
  %11 = load i32, i32* %__do_loop_end, align 4
  %12 = icmp sle i32 %10, %11
  br i1 %12, label %loop.body, label %loop.end

loop.body:                                        ; preds = %loop.head
  %13 = load i32, i32* %__libasr_index_0_, align 4
  %14 = add i32 %13, 1
  store i32 %14, i32* %__libasr_index_0_, align 4
  %15 = load i32, i32* %__libasr_index_0_, align 4
  %16 = sext i32 %15 to i64
  %17 = sub i64 %16, 1
  %18 = mul i64 1, %17
  %19 = add i64 0, %18
  %20 = getelementptr [100 x float], [100 x float]* %small_arr, i32 0, i64 %19
  store float 1.000000e+00, float* %20, align 4
  br label %loop.head

loop.end:                                         ; preds = %loop.head
  br i1 true, label %then6, label %else7

then6:                                            ; preds = %loop.end
  store i32 2000, i32* %array_bound5, align 4
  br label %ifcont8

else7:                                            ; preds = %loop.end
  br label %ifcont8

ifcont8:                                          ; preds = %else7, %then6
  %21 = load i32, i32* %array_bound5, align 4
  store i32 %21, i32* %__do_loop_end1, align 4
  br i1 true, label %then10, label %else11

then10:                                           ; preds = %ifcont8
  store i32 1, i32* %array_bound9, align 4
  br label %ifcont12

else11:                                           ; preds = %ifcont8
  br label %ifcont12

ifcont12:                                         ; preds = %else11, %then10
  %22 = load i32, i32* %array_bound9, align 4
  %23 = sub i32 %22, 1
  store i32 %23, i32* %__libasr_index_0_1, align 4
  br label %loop.head13

loop.head13:                                      ; preds = %loop.body14, %ifcont12
  %24 = load i32, i32* %__libasr_index_0_1, align 4
  %25 = add i32 %24, 1
  %26 = load i32, i32* %__do_loop_end1, align 4
  %27 = icmp sle i32 %25, %26
  br i1 %27, label %loop.body14, label %loop.end15

loop.body14:                                      ; preds = %loop.head13
  %28 = load i32, i32* %__libasr_index_0_1, align 4
  %29 = add i32 %28, 1
  store i32 %29, i32* %__libasr_index_0_1, align 4
  %30 = load i32, i32* %__libasr_index_0_1, align 4
  %31 = sext i32 %30 to i64
  %32 = sub i64 %31, 1
  %33 = mul i64 1, %32
  %34 = add i64 0, %33
  %35 = getelementptr [2000 x float], [2000 x float]* %5, i32 0, i64 %34
  store float 2.000000e+00, float* %35, align 1
  br label %loop.head13

loop.end15:                                       ; preds = %loop.head13
  %36 = getelementptr [100 x float], [100 x float]* %small_arr, i32 0, i64 0
  %37 = load float, float* %36, align 4
  %38 = fcmp une float %37, 1.000000e+00
  br i1 %38, label %then16, label %else17

then16:                                           ; preds = %loop.end15
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @1, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @0, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont18

else17:                                           ; preds = %loop.end15
  br label %ifcont18

ifcont18:                                         ; preds = %else17, %then16
  %39 = getelementptr [2000 x float], [2000 x float]* %5, i32 0, i64 0
  %40 = load float, float* %39, align 1
  %41 = fcmp une float %40, 2.000000e+00
  br i1 %41, label %then19, label %else20

then19:                                           ; preds = %ifcont18
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @3, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @2, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont21

else20:                                           ; preds = %ifcont18
  br label %ifcont21

ifcont21:                                         ; preds = %else20, %then19
  store float 0.000000e+00, float* %sum, align 4
  store i32 0, i32* %i, align 4
  br label %loop.head22

loop.head22:                                      ; preds = %free_done, %ifcont21
  %42 = load i32, i32* %i, align 4
  %43 = add i32 %42, 1
  %44 = icmp sle i32 %43, 1000
  br i1 %44, label %loop.body23, label %loop.end37

loop.body23:                                      ; preds = %loop.head22
  %45 = load i32, i32* %i, align 4
  %46 = add i32 %45, 1
  store i32 %46, i32* %i, align 4
  br label %block.start

block.start:                                      ; preds = %loop.body23
  %47 = call i8* @llvm.stacksave()
  %__do_loop_end24 = alloca i32, align 4
  %__libasr_index_0_25 = alloca i32, align 4
  %48 = call i8* @_lfortran_get_default_allocator()
  %49 = call i8* @_lfortran_malloc_alloc(i8* %48, i64 2000)
  %50 = bitcast i8* %49 to [500 x float]*
  br i1 true, label %then27, label %else28

then27:                                           ; preds = %block.start
  store i32 500, i32* %array_bound26, align 4
  br label %ifcont29

else28:                                           ; preds = %block.start
  br label %ifcont29

ifcont29:                                         ; preds = %else28, %then27
  %51 = load i32, i32* %array_bound26, align 4
  store i32 %51, i32* %__do_loop_end24, align 4
  br i1 true, label %then31, label %else32

then31:                                           ; preds = %ifcont29
  store i32 1, i32* %array_bound30, align 4
  br label %ifcont33

else32:                                           ; preds = %ifcont29
  br label %ifcont33

ifcont33:                                         ; preds = %else32, %then31
  %52 = load i32, i32* %array_bound30, align 4
  %53 = sub i32 %52, 1
  store i32 %53, i32* %__libasr_index_0_25, align 4
  br label %loop.head34

loop.head34:                                      ; preds = %loop.body35, %ifcont33
  %54 = load i32, i32* %__libasr_index_0_25, align 4
  %55 = add i32 %54, 1
  %56 = load i32, i32* %__do_loop_end24, align 4
  %57 = icmp sle i32 %55, %56
  br i1 %57, label %loop.body35, label %loop.end36

loop.body35:                                      ; preds = %loop.head34
  %58 = load i32, i32* %__libasr_index_0_25, align 4
  %59 = add i32 %58, 1
  store i32 %59, i32* %__libasr_index_0_25, align 4
  %60 = load i32, i32* %__libasr_index_0_25, align 4
  %61 = sext i32 %60 to i64
  %62 = sub i64 %61, 1
  %63 = mul i64 1, %62
  %64 = add i64 0, %63
  %65 = getelementptr [500 x float], [500 x float]* %50, i32 0, i64 %64
  %66 = call float @_lcompilers_real_i32(i32* %i)
  store float %66, float* %65, align 1
  br label %loop.head34

loop.end36:                                       ; preds = %loop.head34
  %67 = load float, float* %sum, align 4
  %68 = getelementptr [500 x float], [500 x float]* %50, i32 0, i64 0
  %69 = load float, float* %68, align 1
  %70 = fadd float %67, %69
  store float %70, float* %sum, align 4
  br label %block.end

block.end:                                        ; preds = %loop.end36
  br label %FINALIZE_SYMTABLE_block

FINALIZE_SYMTABLE_block:                          ; preds = %block.end
  %71 = icmp eq i8* %49, null
  br i1 %71, label %free_done, label %free_nonnull

free_nonnull:                                     ; preds = %FINALIZE_SYMTABLE_block
  call void @_lfortran_free_alloc(i8* %2, i8* %49)
  br label %free_done

free_done:                                        ; preds = %free_nonnull, %FINALIZE_SYMTABLE_block
  call void @llvm.stackrestore(i8* %47)
  br label %loop.head22

loop.end37:                                       ; preds = %loop.head22
  %72 = load float, float* %sum, align 4
  %73 = fsub float %72, 5.005000e+05
  %74 = call float @llvm.fabs.f32(float %73)
  %75 = fcmp ogt float %74, 0x3FB99999A0000000
  br i1 %75, label %then38, label %else39

then38:                                           ; preds = %loop.end37
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @5, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @4, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont40

else39:                                           ; preds = %loop.end37
  br label %ifcont40

ifcont40:                                         ; preds = %else39, %then38
  %76 = load i8*, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @string_const, i32 0, i32 0), align 8
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @7, i32 0, i32 0), i8* %76, i32 2, i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @6, i32 0, i32 0), i32 1)
  br label %return

return:                                           ; preds = %ifcont40
  br label %FINALIZE_SYMTABLE_static_large_array

FINALIZE_SYMTABLE_static_large_array:             ; preds = %return
  %77 = icmp eq i8* %4, null
  br i1 %77, label %free_done42, label %free_nonnull41

free_nonnull41:                                   ; preds = %FINALIZE_SYMTABLE_static_large_array
  call void @_lfortran_free_alloc(i8* %2, i8* %4)
  br label %free_done42

free_done42:                                      ; preds = %free_nonnull41, %FINALIZE_SYMTABLE_static_large_array
  call void @_lfortran_internal_alloc_finalize()
  ret i32 0
}

declare void @_lpython_call_initial_functions(i32, i8**)

declare i8* @_lfortran_malloc_alloc(i8*, i64)

declare i8* @_lfortran_get_default_allocator()

declare void @_lcompilers_print_error(i8*, ...)

declare void @_lfortran_internal_alloc_finalize()

declare void @exit(i32)

; Function Attrs: nounwind
declare i8* @llvm.stacksave() #0

declare void @_lfortran_free_alloc(i8*, i8*)

; Function Attrs: nounwind
declare void @llvm.stackrestore(i8*) #0

; Function Attrs: nounwind readnone speculatable willreturn
declare float @llvm.fabs.f32(float) #1

declare void @_lfortran_printf(i8*, i8*, i32, i32, i8*, i32)

attributes #0 = { nounwind }
attributes #1 = { nounwind readnone speculatable willreturn }
