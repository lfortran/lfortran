  br label %do_loop.head15

do_loop.head15:                                   ; preds = %do_loop.body14
  %do_loop.iv.mem16 = load i32, i32* %__libasr_index_0_1, align 4
  %do_loop.next17 = add nsw i32 %do_loop.iv.mem16, 1
  store i32 %do_loop.next17, i32* %__libasr_index_0_1, align 4
  %25 = icmp eq i32 %do_loop.iv.mem16, %17
