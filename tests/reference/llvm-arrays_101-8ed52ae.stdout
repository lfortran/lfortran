; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

%string_descriptor = type { i8*, i64 }

@"ERROR STOP" = private unnamed_addr constant [11 x i8] c"ERROR STOP\00", align 1
@0 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@1 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@2 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@3 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@4 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@5 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@6 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@string_const_data = private constant [2 x i8] c"OK"
@string_const = private global %string_descriptor { i8* getelementptr inbounds ([2 x i8], [2 x i8]* @string_const_data, i32 0, i32 0), i64 2 }
@7 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1

define internal float @_lcompilers_real_i32(i32* %x) {
.entry:
  %_lcompilers_real_i32 = alloca float, align 4
  %0 = load i32, i32* %x, align 1
  %1 = sitofp i32 %0 to float
  store float %1, float* %_lcompilers_real_i32, align 4
  br label %return

return:                                           ; preds = %.entry
  br label %FINALIZE_SYMTABLE__lcompilers_real_i32

FINALIZE_SYMTABLE__lcompilers_real_i32:           ; preds = %return
  %2 = load float, float* %_lcompilers_real_i32, align 4
  ret float %2
}

define i32 @main(i32 %0, i8** %1) {
.entry:
  %2 = call i8* @_lfortran_get_default_allocator()
  %array_bound28 = alloca i32, align 4
  %array_bound24 = alloca i32, align 4
  %array_bound9 = alloca i32, align 4
  %array_bound5 = alloca i32, align 4
  %array_bound1 = alloca i32, align 4
  %array_bound = alloca i32, align 4
  call void @_lpython_call_initial_functions(i32 %0, i8** %1)
  %__libasr_index_0_ = alloca i32, align 4
  %__libasr_index_0_1 = alloca i32, align 4
  %i = alloca i32, align 4
  %3 = call i8* @_lfortran_get_default_allocator()
  %4 = call i8* @_lfortran_malloc_alloc(i8* %3, i64 8000)
  %5 = bitcast i8* %4 to [2000 x float]*
  %small_arr = alloca [100 x float], align 16
  %sum = alloca float, align 4
  br i1 true, label %then, label %else

then:                                             ; preds = %.entry
  store i32 1, i32* %array_bound, align 4
  br label %ifcont

else:                                             ; preds = %.entry
  br label %ifcont

ifcont:                                           ; preds = %else, %then
  %6 = load i32, i32* %array_bound, align 4
  br i1 true, label %then2, label %else3

then2:                                            ; preds = %ifcont
  store i32 100, i32* %array_bound1, align 4
  br label %ifcont4

else3:                                            ; preds = %ifcont
  br label %ifcont4

ifcont4:                                          ; preds = %else3, %then2
  %7 = load i32, i32* %array_bound1, align 4
  store i32 %6, i32* %__libasr_index_0_, align 4
  %8 = icmp sle i32 %6, %7
  br i1 %8, label %do_loop.body, label %do_loop.end

do_loop.body:                                     ; preds = %do_loop.head, %ifcont4
  %9 = load i32, i32* %__libasr_index_0_, align 4
  %10 = sext i32 %9 to i64
  %11 = sub i64 %10, 1
  %12 = mul i64 1, %11
  %13 = add i64 0, %12
  %14 = getelementptr [100 x float], [100 x float]* %small_arr, i32 0, i64 %13
  store float 1.000000e+00, float* %14, align 4
  br label %do_loop.head

do_loop.head:                                     ; preds = %do_loop.body
  %15 = load i32, i32* %__libasr_index_0_, align 4
  %16 = add nsw i32 %15, 1
  store i32 %16, i32* %__libasr_index_0_, align 4
  %17 = icmp eq i32 %15, %7
  br i1 %17, label %do_loop.end, label %do_loop.body

do_loop.end:                                      ; preds = %do_loop.head, %ifcont4
  br i1 true, label %then6, label %else7

then6:                                            ; preds = %do_loop.end
  store i32 1, i32* %array_bound5, align 4
  br label %ifcont8

else7:                                            ; preds = %do_loop.end
  br label %ifcont8

ifcont8:                                          ; preds = %else7, %then6
  %18 = load i32, i32* %array_bound5, align 4
  br i1 true, label %then10, label %else11

then10:                                           ; preds = %ifcont8
  store i32 2000, i32* %array_bound9, align 4
  br label %ifcont12

else11:                                           ; preds = %ifcont8
  br label %ifcont12

ifcont12:                                         ; preds = %else11, %then10
  %19 = load i32, i32* %array_bound9, align 4
  store i32 %18, i32* %__libasr_index_0_1, align 4
  %20 = icmp sle i32 %18, %19
  br i1 %20, label %do_loop.body13, label %do_loop.end15

do_loop.body13:                                   ; preds = %do_loop.head14, %ifcont12
  %21 = load i32, i32* %__libasr_index_0_1, align 4
  %22 = sext i32 %21 to i64
  %23 = sub i64 %22, 1
  %24 = mul i64 1, %23
  %25 = add i64 0, %24
  %26 = getelementptr [2000 x float], [2000 x float]* %5, i32 0, i64 %25
  store float 2.000000e+00, float* %26, align 1
  br label %do_loop.head14

do_loop.head14:                                   ; preds = %do_loop.body13
  %27 = load i32, i32* %__libasr_index_0_1, align 4
  %28 = add nsw i32 %27, 1
  store i32 %28, i32* %__libasr_index_0_1, align 4
  %29 = icmp eq i32 %27, %19
  br i1 %29, label %do_loop.end15, label %do_loop.body13

do_loop.end15:                                    ; preds = %do_loop.head14, %ifcont12
  %30 = getelementptr [100 x float], [100 x float]* %small_arr, i32 0, i64 0
  %31 = load float, float* %30, align 4
  %32 = fcmp une float %31, 1.000000e+00
  br i1 %32, label %then16, label %else17

then16:                                           ; preds = %do_loop.end15
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @1, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @0, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont18

else17:                                           ; preds = %do_loop.end15
  br label %ifcont18

ifcont18:                                         ; preds = %else17, %then16
  %33 = getelementptr [2000 x float], [2000 x float]* %5, i32 0, i64 0
  %34 = load float, float* %33, align 1
  %35 = fcmp une float %34, 2.000000e+00
  br i1 %35, label %then19, label %else20

then19:                                           ; preds = %ifcont18
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @3, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @2, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont21

else20:                                           ; preds = %ifcont18
  br label %ifcont21

ifcont21:                                         ; preds = %else20, %then19
  store float 0.000000e+00, float* %sum, align 4
  store i32 1, i32* %i, align 4
  br i1 true, label %do_loop.body22, label %do_loop.end36

do_loop.body22:                                   ; preds = %do_loop.head35, %ifcont21
  br label %block.start

block.start:                                      ; preds = %do_loop.body22
  %36 = call i8* @llvm.stacksave()
  %__libasr_index_0_23 = alloca i32, align 4
  %37 = call i8* @_lfortran_get_default_allocator()
  %38 = call i8* @_lfortran_malloc_alloc(i8* %37, i64 2000)
  %39 = bitcast i8* %38 to [500 x float]*
  br i1 true, label %then25, label %else26

then25:                                           ; preds = %block.start
  store i32 1, i32* %array_bound24, align 4
  br label %ifcont27

else26:                                           ; preds = %block.start
  br label %ifcont27

ifcont27:                                         ; preds = %else26, %then25
  %40 = load i32, i32* %array_bound24, align 4
  br i1 true, label %then29, label %else30

then29:                                           ; preds = %ifcont27
  store i32 500, i32* %array_bound28, align 4
  br label %ifcont31

else30:                                           ; preds = %ifcont27
  br label %ifcont31

ifcont31:                                         ; preds = %else30, %then29
  %41 = load i32, i32* %array_bound28, align 4
  store i32 %40, i32* %__libasr_index_0_23, align 4
  %42 = icmp sle i32 %40, %41
  br i1 %42, label %do_loop.body32, label %do_loop.end34

do_loop.body32:                                   ; preds = %do_loop.head33, %ifcont31
  %43 = load i32, i32* %__libasr_index_0_23, align 4
  %44 = sext i32 %43 to i64
  %45 = sub i64 %44, 1
  %46 = mul i64 1, %45
  %47 = add i64 0, %46
  %48 = getelementptr [500 x float], [500 x float]* %39, i32 0, i64 %47
  %49 = call float @_lcompilers_real_i32(i32* %i)
  store float %49, float* %48, align 1
  br label %do_loop.head33

do_loop.head33:                                   ; preds = %do_loop.body32
  %50 = load i32, i32* %__libasr_index_0_23, align 4
  %51 = add nsw i32 %50, 1
  store i32 %51, i32* %__libasr_index_0_23, align 4
  %52 = icmp eq i32 %50, %41
  br i1 %52, label %do_loop.end34, label %do_loop.body32

do_loop.end34:                                    ; preds = %do_loop.head33, %ifcont31
  %53 = load float, float* %sum, align 4
  %54 = getelementptr [500 x float], [500 x float]* %39, i32 0, i64 0
  %55 = load float, float* %54, align 1
  %56 = fadd float %53, %55
  store float %56, float* %sum, align 4
  br label %block.end

block.end:                                        ; preds = %do_loop.end34
  br label %FINALIZE_SYMTABLE_block

FINALIZE_SYMTABLE_block:                          ; preds = %block.end
  %57 = icmp eq i8* %38, null
  br i1 %57, label %free_done, label %free_nonnull

free_nonnull:                                     ; preds = %FINALIZE_SYMTABLE_block
  call void @_lfortran_free_alloc(i8* %2, i8* %38)
  br label %free_done

free_done:                                        ; preds = %free_nonnull, %FINALIZE_SYMTABLE_block
  call void @llvm.stackrestore(i8* %36)
  br label %do_loop.head35

do_loop.head35:                                   ; preds = %free_done
  %58 = load i32, i32* %i, align 4
  %59 = add nsw i32 %58, 1
  store i32 %59, i32* %i, align 4
  %60 = icmp eq i32 %58, 1000
  br i1 %60, label %do_loop.end36, label %do_loop.body22

do_loop.end36:                                    ; preds = %do_loop.head35, %ifcont21
  %61 = load float, float* %sum, align 4
  %62 = fsub float %61, 5.005000e+05
  %63 = call float @llvm.fabs.f32(float %62)
  %64 = fcmp ogt float %63, 0x3FB99999A0000000
  br i1 %64, label %then37, label %else38

then37:                                           ; preds = %do_loop.end36
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @5, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @4, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont39

else38:                                           ; preds = %do_loop.end36
  br label %ifcont39

ifcont39:                                         ; preds = %else38, %then37
  %65 = load i8*, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @string_const, i32 0, i32 0), align 8
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @7, i32 0, i32 0), i8* %65, i32 2, i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @6, i32 0, i32 0), i32 1)
  br label %return

return:                                           ; preds = %ifcont39
  br label %FINALIZE_SYMTABLE_static_large_array

FINALIZE_SYMTABLE_static_large_array:             ; preds = %return
  %66 = icmp eq i8* %4, null
  br i1 %66, label %free_done41, label %free_nonnull40

free_nonnull40:                                   ; preds = %FINALIZE_SYMTABLE_static_large_array
  call void @_lfortran_free_alloc(i8* %2, i8* %4)
  br label %free_done41

free_done41:                                      ; preds = %free_nonnull40, %FINALIZE_SYMTABLE_static_large_array
  call void @_lfortran_internal_alloc_finalize()
