  br label %do_loop.head

do_loop.head:                                     ; preds = %do_loop.body
  %do_loop.iv.mem = load i32, i32* %__libasr_index_0_, align 4
  %do_loop.next = add nsw i32 %do_loop.iv.mem, 1
  store i32 %do_loop.next, i32* %__libasr_index_0_, align 4
  %15 = icmp eq i32 %do_loop.iv.mem, %7
  br i1 %15, label %do_loop.end, label %do_loop.body

do_loop.end:                                      ; preds = %do_loop.head, %do_loop.cond
  br i1 true, label %then6, label %else7

then6:                                            ; preds = %do_loop.end
  store i32 1, i32* %array_bound5, align 4
  br label %ifcont8

else7:                                            ; preds = %do_loop.end
  br label %ifcont8

ifcont8:                                          ; preds = %else7, %then6
  %16 = load i32, i32* %array_bound5, align 4
  br i1 true, label %then10, label %else11

then10:                                           ; preds = %ifcont8
  store i32 2000, i32* %array_bound9, align 4
  br label %ifcont12

else11:                                           ; preds = %ifcont8
  br label %ifcont12

ifcont12:                                         ; preds = %else11, %then10
  %17 = load i32, i32* %array_bound9, align 4
  store i32 %16, i32* %__libasr_index_0_1, align 4
  br label %do_loop.cond13

do_loop.cond13:                                   ; preds = %ifcont12
  %18 = icmp sle i32 %16, %17
  br i1 %18, label %do_loop.body14, label %do_loop.end18

do_loop.body14:                                   ; preds = %do_loop.head15, %do_loop.cond13
  %19 = load i32, i32* %__libasr_index_0_1, align 4
  %20 = sext i32 %19 to i64
  %21 = sub i64 %20, 1
  %22 = mul i64 1, %21
  %23 = add i64 0, %22
  %24 = getelementptr [2000 x float], [2000 x float]* %5, i32 0, i64 %23
