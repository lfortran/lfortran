else20:                                           ; preds = %do_loop.end18
  br label %ifcont21

ifcont21:                                         ; preds = %else20, %then19
  %29 = getelementptr [2000 x float], [2000 x float]* %5, i32 0, i64 0
  %30 = load float, float* %29, align 1
  %31 = fcmp une float %30, 2.000000e+00
  br i1 %31, label %then22, label %else23

then22:                                           ; preds = %ifcont21
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @3, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @2, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont24

else23:                                           ; preds = %ifcont21
  br label %ifcont24

ifcont24:                                         ; preds = %else23, %then22
  store float 0.000000e+00, float* %sum, align 4
  store i32 1, i32* %i, align 4
  br label %do_loop.cond25

do_loop.cond25:                                   ; preds = %ifcont24
  br i1 true, label %do_loop.body26, label %do_loop.end45

do_loop.body26:                                   ; preds = %do_loop.head42, %do_loop.cond25
  br label %block.start

block.start:                                      ; preds = %do_loop.body26
  %32 = call i8* @llvm.stacksave()
  %__libasr_index_0_27 = alloca i32, align 4
  %33 = call i8* @_lfortran_get_default_allocator()
  %34 = call i8* @_lfortran_malloc_alloc(i8* %33, i64 2000)
  %35 = bitcast i8* %34 to [500 x float]*
  br i1 true, label %then29, label %else30

then29:                                           ; preds = %block.start
  store i32 1, i32* %array_bound28, align 4
  br label %ifcont31

else30:                                           ; preds = %block.start
  br label %ifcont31

ifcont31:                                         ; preds = %else30, %then29
  %36 = load i32, i32* %array_bound28, align 4
  br i1 true, label %then33, label %else34

then33:                                           ; preds = %ifcont31
  store i32 500, i32* %array_bound32, align 4
  br label %ifcont35

else34:                                           ; preds = %ifcont31
  br label %ifcont35

ifcont35:                                         ; preds = %else34, %then33
  %37 = load i32, i32* %array_bound32, align 4
  store i32 %36, i32* %__libasr_index_0_27, align 4
  br label %do_loop.cond36

do_loop.cond36:                                   ; preds = %ifcont35
  %38 = icmp sle i32 %36, %37
  br i1 %38, label %do_loop.body37, label %do_loop.end41

do_loop.body37:                                   ; preds = %do_loop.head38, %do_loop.cond36
  %39 = load i32, i32* %__libasr_index_0_27, align 4
  %40 = sext i32 %39 to i64
  %41 = sub i64 %40, 1
  %42 = mul i64 1, %41
  %43 = add i64 0, %42
  %44 = getelementptr [500 x float], [500 x float]* %35, i32 0, i64 %43
  %45 = call float @_lcompilers_real_i32(i32* %i)
  store float %45, float* %44, align 1
  br label %do_loop.head38

do_loop.head38:                                   ; preds = %do_loop.body37
  %do_loop.iv.mem39 = load i32, i32* %__libasr_index_0_27, align 4
  %do_loop.next40 = add nsw i32 %do_loop.iv.mem39, 1
  store i32 %do_loop.next40, i32* %__libasr_index_0_27, align 4
  %46 = icmp eq i32 %do_loop.iv.mem39, %37
  br i1 %46, label %do_loop.end41, label %do_loop.body37

do_loop.end41:                                    ; preds = %do_loop.head38, %do_loop.cond36
  %47 = load float, float* %sum, align 4
  %48 = getelementptr [500 x float], [500 x float]* %35, i32 0, i64 0
  %49 = load float, float* %48, align 1
  %50 = fadd float %47, %49
  store float %50, float* %sum, align 4
