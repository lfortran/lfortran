; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

%string_descriptor = type <{ ptr, i64 }>

@"ERROR STOP" = private unnamed_addr constant [11 x i8] c"ERROR STOP\00", align 1
@0 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@1 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@string_const_data = private constant [1 x i8] c"a"
@string_const = private global %string_descriptor <{ ptr @string_const_data, i64 1 }>
@2 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@3 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@4 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@5 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@string_const_data.1 = private constant [1 x i8] c"a"
@string_const.2 = private global %string_descriptor <{ ptr @string_const_data.1, i64 1 }>
@string_const_data.3 = private constant [10 x i8] c"1234567890"
@string_const.4 = private global %string_descriptor <{ ptr @string_const_data.3, i64 10 }>
@6 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@7 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@string_const_data.5 = private constant [10 x i8] c"1234567890"
@string_const.6 = private global %string_descriptor <{ ptr @string_const_data.5, i64 10 }>
@8 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@9 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1

define i32 @main(i32 %0, ptr %1) {
.entry:
  %2 = call ptr @_lfortran_get_default_allocator()
  %call_arg_value1 = alloca i32, align 4
  %call_arg_value = alloca i32, align 4
  %a = alloca %string_descriptor, align 8
  %__libasr_created_variable_ = alloca %string_descriptor, align 8
  call void @_lpython_call_initial_functions(i32 %0, ptr %1)
  store %string_descriptor zeroinitializer, ptr %__libasr_created_variable_, align 1
  %3 = getelementptr %string_descriptor, ptr %__libasr_created_variable_, i32 0, i32 1
  store i64 0, ptr %3, align 8
  %4 = getelementptr %string_descriptor, ptr %__libasr_created_variable_, i32 0, i32 0
  %5 = call ptr @_lfortran_get_default_allocator()
  %6 = call ptr @_lfortran_malloc_alloc(ptr %5, i64 1)
  store ptr %6, ptr %4, align 8
  store %string_descriptor zeroinitializer, ptr %a, align 1
  %7 = getelementptr %string_descriptor, ptr %a, i32 0, i32 1
  store i64 10, ptr %7, align 8
  %8 = getelementptr %string_descriptor, ptr %a, i32 0, i32 0
  %9 = call ptr @_lfortran_get_default_allocator()
  %10 = call ptr @_lfortran_malloc_alloc(ptr %9, i64 10)
  store ptr %10, ptr %8, align 8
  store i32 1, ptr %call_arg_value, align 4
  store i32 0, ptr %call_arg_value1, align 4
  call void @check(ptr %call_arg_value, ptr %__libasr_created_variable_, ptr %call_arg_value1)
  store i32 1, ptr %call_arg_value, align 4
  store i32 1, ptr %call_arg_value1, align 4
  call void @check(ptr %call_arg_value, ptr @string_const.2, ptr %call_arg_value1)
  %11 = getelementptr %string_descriptor, ptr %a, i32 0, i32 0
  %12 = getelementptr %string_descriptor, ptr %a, i32 0, i32 1
  %13 = load ptr, ptr @string_const.4, align 8
  call void @_lfortran_strcpy_alloc(ptr %2, ptr %11, ptr %12, i8 0, i8 0, ptr %13, i64 10, i32 1)
  store i32 3, ptr %call_arg_value, align 4
  store i32 1, ptr %call_arg_value1, align 4
  call void @sub(ptr %call_arg_value, ptr %a, ptr %call_arg_value1)
  br i1 false, label %then, label %else

then:                                             ; preds = %.entry
  call void (ptr, ...) @_lcompilers_print_error(ptr @7, ptr @"ERROR STOP", ptr @6)
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont

else:                                             ; preds = %.entry
  br label %ifcont

ifcont:                                           ; preds = %else, %then
  %14 = getelementptr %string_descriptor, ptr %a, i32 0, i32 0
  %15 = load ptr, ptr %14, align 8
  %16 = load ptr, ptr @string_const.6, align 8
  %17 = call i32 @str_compare(ptr %15, i64 10, ptr %16, i64 10)
  %18 = icmp ne i32 %17, 0
  br i1 %18, label %then2, label %else3

then2:                                            ; preds = %ifcont
  call void (ptr, ...) @_lcompilers_print_error(ptr @9, ptr @"ERROR STOP", ptr @8)
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont4

else3:                                            ; preds = %ifcont
  br label %ifcont4

ifcont4:                                          ; preds = %else3, %then2
  br label %return

return:                                           ; preds = %ifcont4
  br label %FINALIZE_SYMTABLE_optional_string_arg_01

FINALIZE_SYMTABLE_optional_string_arg_01:         ; preds = %return
  br label %Finalize_Variable___libasr_created_variable_

Finalize_Variable___libasr_created_variable_:     ; preds = %FINALIZE_SYMTABLE_optional_string_arg_01
  %19 = getelementptr %string_descriptor, ptr %__libasr_created_variable_, i32 0, i32 0
  %20 = load ptr, ptr %19, align 8
  call void @_lfortran_free_alloc(ptr %2, ptr %20)
  br label %Finalize_Variable_a

Finalize_Variable_a:                              ; preds = %Finalize_Variable___libasr_created_variable_
  %21 = getelementptr %string_descriptor, ptr %a, i32 0, i32 0
  %22 = load ptr, ptr %21, align 8
  call void @_lfortran_free_alloc(ptr %2, ptr %22)
  call void @_lfortran_internal_alloc_finalize()
  ret i32 0
}

define void @check(ptr %n, ptr %s, ptr %__libasr_is_present_s) {
.entry:
  %0 = getelementptr %string_descriptor, ptr %s, i32 0, i32 1
  %1 = load i64, ptr %0, align 8
  %2 = trunc i64 %1 to i32
  %3 = icmp ne i32 %2, 1
  br i1 %3, label %then, label %else

then:                                             ; preds = %.entry
  call void (ptr, ...) @_lcompilers_print_error(ptr @1, ptr @"ERROR STOP", ptr @0)
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont

else:                                             ; preds = %.entry
  br label %ifcont

ifcont:                                           ; preds = %else, %then
  %4 = load i32, ptr %__libasr_is_present_s, align 4
  %5 = icmp ne i32 %4, 0
  br i1 %5, label %then1, label %else5

then1:                                            ; preds = %ifcont
  %6 = getelementptr %string_descriptor, ptr %s, i32 0, i32 0
  %7 = load ptr, ptr %6, align 8
  %8 = getelementptr %string_descriptor, ptr %s, i32 0, i32 1
  %9 = load i64, ptr %8, align 8
  %10 = load ptr, ptr @string_const, align 8
  %11 = call i32 @str_compare(ptr %7, i64 %9, ptr %10, i64 1)
  %12 = icmp ne i32 %11, 0
  br i1 %12, label %then2, label %else3

then2:                                            ; preds = %then1
  call void (ptr, ...) @_lcompilers_print_error(ptr @3, ptr @"ERROR STOP", ptr @2)
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont4

else3:                                            ; preds = %then1
  br label %ifcont4

ifcont4:                                          ; preds = %else3, %then2
  br label %ifcont6

else5:                                            ; preds = %ifcont
  br label %ifcont6

ifcont6:                                          ; preds = %else5, %ifcont4
  br label %return

return:                                           ; preds = %ifcont6
  br label %FINALIZE_SYMTABLE_check

FINALIZE_SYMTABLE_check:                          ; preds = %return
  ret void
}

define void @sub(ptr %n, ptr %s, ptr %__libasr_is_present_s) {
.entry:
  %0 = getelementptr %string_descriptor, ptr %s, i32 0, i32 1
  %1 = load i64, ptr %0, align 8
  %2 = trunc i64 %1 to i32
  %3 = icmp ne i32 %2, 3
  br i1 %3, label %then, label %else

then:                                             ; preds = %.entry
  call void (ptr, ...) @_lcompilers_print_error(ptr @5, ptr @"ERROR STOP", ptr @4)
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont

else:                                             ; preds = %.entry
  br label %ifcont

ifcont:                                           ; preds = %else, %then
  br label %return

return:                                           ; preds = %ifcont
  br label %FINALIZE_SYMTABLE_sub

FINALIZE_SYMTABLE_sub:                            ; preds = %return
  ret void
}

declare void @_lcompilers_print_error(ptr, ...)

declare void @_lfortran_internal_alloc_finalize()

declare void @exit(i32)

declare i32 @str_compare(ptr, i64, ptr, i64)

declare void @_lpython_call_initial_functions(i32, ptr)

declare ptr @_lfortran_malloc_alloc(ptr, i64)

declare ptr @_lfortran_get_default_allocator()

declare void @_lfortran_strcpy_alloc(ptr, ptr, ptr, i8, i8, ptr, i64, i32)

declare void @_lfortran_free_alloc(ptr, ptr)
