; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

define void @a() {
.entry:
  %call_arg_value1 = alloca { i8*, i8* }, align 8
  store { i8*, i8* } zeroinitializer, { i8*, i8* }* %call_arg_value1, align 8
  %call_arg_value = alloca { i8*, i8* }, align 8
  store { i8*, i8* } zeroinitializer, { i8*, i8* }* %call_arg_value, align 8
  %"b~fpcast_ptr" = alloca { i8*, i8* }, align 8
  store { i8*, i8* } zeroinitializer, { i8*, i8* }* %"b~fpcast_ptr", align 8
  store { i8*, i8* } { i8* bitcast (void ()* @b to i8*), i8* null }, { i8*, i8* }* %"b~fpcast_ptr", align 8
  %0 = load { i8*, i8* }, { i8*, i8* }* %"b~fpcast_ptr", align 8
  store { i8*, i8* } { i8* bitcast (float ()* @f to i8*), i8* null }, { i8*, i8* }* %call_arg_value, align 8
  store { i8*, i8* } { i8* bitcast (float ()* @g to i8*), i8* null }, { i8*, i8* }* %call_arg_value1, align 8
  %1 = extractvalue { i8*, i8* } %0, 0
  %2 = extractvalue { i8*, i8* } %0, 1
  %3 = icmp eq i8* %2, null
  br i1 %3, label %then, label %else

then:                                             ; preds = %.entry
  %4 = bitcast i8* %1 to void ({ i8*, i8* }*, { i8*, i8* }*)*
  call void %4({ i8*, i8* }* %call_arg_value, { i8*, i8* }* %call_arg_value1)
  br label %ifcont

else:                                             ; preds = %.entry
  %5 = bitcast i8* %1 to void (i8*, { i8*, i8* }*, { i8*, i8* }*)*
  call void %5(i8* %2, { i8*, i8* }* %call_arg_value, { i8*, i8* }* %call_arg_value1)
  br label %ifcont

ifcont:                                           ; preds = %else, %then
  br label %return

return:                                           ; preds = %ifcont
  br label %FINALIZE_SYMTABLE_a

FINALIZE_SYMTABLE_a:                              ; preds = %return
  ret void
}

declare void @b()

declare void @"b~fpcast"({ i8*, i8* }*, { i8*, i8* }*)

declare void @"b~fpcast_ptr"({ i8*, i8* }*, { i8*, i8* }*)

declare float @f()

declare float @g()
