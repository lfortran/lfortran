; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

define void @a_() {
.entry:
  call void @b_(float ()* @f_, float ()* @g_)
  br label %return

return:                                           ; preds = %.entry
  br label %FINALIZE_SYMTABLE_a_

FINALIZE_SYMTABLE_a_:                             ; preds = %return
  ret void
}

declare void @b_(float ()*, float ()*)

declare float @f_()

declare float @g_()
