program expr_25
! Parentheses that the grouping does not need are kept in the AST,
! so that --show-ast-f90 prints them back: the standard requires
! them to be honored, and compilers do
implicit none
real :: a, b, c, x
a = 1.0
b = 2.0
c = 3.0
x = (a*b) + c
if (x /= 5.0) then
    error stop
end if
x = (a/b)*c
if (x /= 1.5) then
    error stop
end if
x = ((a + b))
if (x /= 3.0) then
    error stop
end if
x = c - (a*b)
if (x /= 1.0) then
    error stop
end if
if ((a + b) > c) then
    error stop
end if
end program expr_25
