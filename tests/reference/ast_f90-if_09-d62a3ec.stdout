program if_09
! Logical IF statements
implicit none
integer :: i, n
n = 0
do i = -2, 2
    select case (i)
        case (:-1)
            if (i == -2) then
                n = n + 1
            end if ! a comment
        case (0)
            n = n + 10
        case (1:)
            if (i == 2) then
                n = n + 100
            end if
    end select
end do
if (n /= 111) then
    error stop
end if
i = 0
10 i = i + 1
if (i < 3) then
    go to 10
end if
if (i /= 3) then
    error stop
end if
end program if_09
