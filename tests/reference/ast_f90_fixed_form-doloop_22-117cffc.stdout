program doloop_22
implicit none
integer :: i, j, k, n
n = 0
do 10 i = 1, 3
    do 10 j = 1, 3
        if (j == 2) then
            go to 10
        end if
        n = n + 1
        10 continue
if (n /= 6) then
    error stop
end if
k = 0
do 20 i = 1, 2
    do 20 j = 1, 2
        20 k = k + i*j
if (k /= 9) then
    error stop
end if
n = 0
do 30 i = 1, 4
    if (i == 3) then
        go to 30
    end if
    n = n + i
    30 continue
if (n /= 7) then
    error stop
end if
n = 0
do 40 i = 1, 5, 2
    40 n = n + i
if (n /= 9) then
    error stop
end if
end program doloop_22
