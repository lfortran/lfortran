program doloop_19
integer :: i, s
s = 0
do i = 1, 5
    s = s + i
end do
if (s /= 15) error stop
s = 0
do i = 1, 5
    if (i == 3) go to 1
    s = s + i
1 end do
if (s /= 12) error stop
s = 0
do i = 1, 5
    if (i == 3) go to 2
    s = s + i
2 end do
if (s /= 12) error stop
s = 0
do i = 1, 5
    if (i == 3) go to 3
    s = s + i
3 end do
if (s /= 12) error stop
end program doloop_19
