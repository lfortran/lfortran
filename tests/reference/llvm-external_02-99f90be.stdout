; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

define void @cobyla_(void (double*)* %calcfc_) {
.entry:
  call void @cobylb_(void (double*)* %calcfc_)
  br label %return

unreachable_after_return:                         ; No predecessors!
  br label %return

return:                                           ; preds = %unreachable_after_return, %.entry
  br label %FINALIZE_SYMTABLE_cobyla_

FINALIZE_SYMTABLE_cobyla_:                        ; preds = %return
  ret void
}

declare void @calcfc_(double*)

define void @cobylb_(void (double*)* %calcfc_) {
.entry:
  %con = alloca double, align 8
  call void %calcfc_(double* %con)
  br label %return

unreachable_after_return:                         ; No predecessors!
  br label %return

return:                                           ; preds = %unreachable_after_return, %.entry
  br label %FINALIZE_SYMTABLE_cobylb_

FINALIZE_SYMTABLE_cobylb_:                        ; preds = %return
  ret void
}

declare void @calcfc_.1(double*)
