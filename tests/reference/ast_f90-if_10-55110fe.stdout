program if_10
! ELSE IF parts, and ELSE followed by an IF construct
implicit none
integer :: k, w, s
s = 0
do k = 1, 6
    w = 0
    if (k == 1) then
        w = 1
    else if (k == 2) then
        w = 2
    else if (k == 3) then
    else if (k == 4) then
        w = 4
    else
        if (k == 5) then
            w = 5
        end if
    end if
    s = s + w
end do
if (s /= 12) then
    error stop
end if
print *, s
end program if_10
