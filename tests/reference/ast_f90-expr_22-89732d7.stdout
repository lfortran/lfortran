program expr_22
! Parentheses that group the right operand of a binary operator
! of the same precedence change the result
implicit none
real(8) :: a, b, c, x
integer :: i, j, k
logical :: l, m, n
a = 1.0d20
b = -1.0d20
c = 1.0d0
x = a + (b + c)
if (x /= 0.0d0) then
    error stop
end if
x = a + b + c
if (x /= 1.0d0) then
    error stop
end if
a = 1.0d300
b = 1.0d10
c = 1.0d-10
x = a*(b*c)
if (x /= 1.0d300) then
    error stop
end if
x = -(-a)
if (x /= a) then
    error stop
end if
i = 2
j = 3
k = 2
if ((i**j)**k /= 64) then
    error stop
end if
if (i**j**k /= 512) then
    error stop
end if
if (i - (j - k) /= 1) then
    error stop
end if
l = .true.
m = .true.
n = .true.
if (.not.(l .or. (m .neqv. n))) then
    error stop
end if
if (l .or. m .neqv. n) then
    error stop
end if
if (.not.(l .and. (m .and. n))) then
    error stop
end if
end program expr_22
