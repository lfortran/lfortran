// The value in the first lane of the iteration, in every lane.
// With one lane per iteration the threads of a warp run different
// iterations, which need not reach the same shuffle, and the value
// is the thread's own.
template <typename T>
__device__ inline T __lfortran_lane_broadcast(T v, int lanes, unsigned mask) {
    if (lanes <= 1) return v;
    if (lanes <= 32) return __shfl_sync(mask, v, 0, lanes);
