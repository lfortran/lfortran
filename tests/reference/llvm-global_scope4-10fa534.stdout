; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

@x = global i32 0
@__lcompilers_init_entered = internal global i64 0, align 8

define i32 @__lfortran_evaluate_1() {
.entry:
  call void @_lcompilers_init_enter(i64* @__lcompilers_init_entered)
  %__lfortran_evaluate_11 = alloca i32, align 4
  store i32 6, i32* @x, align 4
  %0 = load i32, i32* @x, align 4
  %1 = add i32 %0, 1
  store i32 %1, i32* @x, align 4
  %2 = load i32, i32* @x, align 4
  %3 = mul i32 3, %2
  store i32 %3, i32* %__lfortran_evaluate_11, align 4
  br label %return

return:                                           ; preds = %.entry
  br label %FINALIZE_SYMTABLE___lfortran_evaluate_1

FINALIZE_SYMTABLE___lfortran_evaluate_1:          ; preds = %return
  %4 = load i32, i32* %__lfortran_evaluate_11, align 4
  ret i32 %4
}

declare void @_lcompilers_init_enter(i64*)
