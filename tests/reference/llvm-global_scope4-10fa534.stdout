; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

@x = global i32 0
@_lfortran_cell_interrupt = external global i32, align 4

define i32 @__lfortran_evaluate_1() {
.entry:
  %__lfortran_evaluate_11 = alloca i32, align 4
  %0 = load atomic i32, i32* @_lfortran_cell_interrupt monotonic, align 4
  %1 = icmp ne i32 %0, 0
  br i1 %1, label %interrupt_stop, label %interrupt_cont

interrupt_stop:                                   ; preds = %.entry
  call void @_lfortran_stop_if_interrupted()
  br label %interrupt_cont

interrupt_cont:                                   ; preds = %interrupt_stop, %.entry
  store i32 6, i32* @x, align 4
  %2 = load i32, i32* @x, align 4
  %3 = add i32 %2, 1
  store i32 %3, i32* @x, align 4
  %4 = load i32, i32* @x, align 4
  %5 = mul i32 3, %4
  store i32 %5, i32* %__lfortran_evaluate_11, align 4
  br label %return

return:                                           ; preds = %interrupt_cont
  br label %FINALIZE_SYMTABLE___lfortran_evaluate_1

FINALIZE_SYMTABLE___lfortran_evaluate_1:          ; preds = %return
  %6 = load i32, i32* %__lfortran_evaluate_11, align 4
  ret i32 %6
}

declare void @_lfortran_stop_if_interrupted()
