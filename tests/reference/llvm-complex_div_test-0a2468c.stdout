; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

%string_descriptor = type <{ i8*, i64 }>
%complex_4 = type <{ float, float }>

@0 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info = private unnamed_addr constant [8 x i8] c"{R4,R4}\00", align 1
@1 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@2 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info.1 = private unnamed_addr constant [8 x i8] c"{R4,R4}\00", align 1
@3 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@4 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info.2 = private unnamed_addr constant [8 x i8] c"{R4,R4}\00", align 1
@5 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1

define i32 @main(i32 %0, i8** %1) {
.entry:
  %stringFormat_desc10 = alloca %string_descriptor, align 8
  %stringFormat_desc4 = alloca %string_descriptor, align 8
  %stringFormat_desc = alloca %string_descriptor, align 8
  %2 = call i8* @_lfortran_get_default_allocator()
  call void @_lpython_call_initial_functions(i32 %0, i8** %1)
  %x = alloca %complex_4, align 8
  store %complex_4 <{ float 3.000000e+00, float 4.000000e+00 }>, %complex_4* %x, align 1
  %3 = load %complex_4, %complex_4* %x, align 1
  %4 = extractvalue %complex_4 %3, 0
  %5 = extractvalue %complex_4 %3, 1
  %6 = call float @llvm.fabs.f32(float 4.000000e+00)
  %7 = call float @llvm.fabs.f32(float 0.000000e+00)
  %8 = fcmp oge float %6, %7
  br i1 %8, label %complex_div_r_ge_s, label %complex_div_r_lt_s

complex_div_r_ge_s:                               ; preds = %.entry
  %9 = fmul float %5, 0.000000e+00
  %10 = fadd float %4, %9
  %11 = fmul float %4, 0.000000e+00
  %12 = fsub float %5, %11
  %13 = fdiv float %10, 4.000000e+00
  %14 = fdiv float %12, 4.000000e+00
  br label %complex_div_cont

complex_div_r_lt_s:                               ; preds = %.entry
  %15 = fmul float %4, 0x7FF0000000000000
  %16 = fadd float %15, %5
  %17 = fmul float %5, 0x7FF0000000000000
  %18 = fsub float %17, %4
  %19 = fdiv float %16, 0x7FF0000000000000
  %20 = fdiv float %18, 0x7FF0000000000000
  br label %complex_div_cont

complex_div_cont:                                 ; preds = %complex_div_r_lt_s, %complex_div_r_ge_s
  %21 = phi float [ %13, %complex_div_r_ge_s ], [ %19, %complex_div_r_lt_s ]
  %22 = phi float [ %14, %complex_div_r_ge_s ], [ %20, %complex_div_r_lt_s ]
  %23 = insertvalue %complex_4 undef, float %21, 0
  %24 = insertvalue %complex_4 %23, float %22, 1
  store %complex_4 %24, %complex_4* %x, align 1
  %25 = call i8* @llvm.stacksave()
  %26 = alloca i64, align 8
  %27 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, ...) @_lcompilers_string_format_fortran(i8* %2, i8* null, i64 0, i8* getelementptr inbounds ([8 x i8], [8 x i8]* @serialization_info, i32 0, i32 0), i64* %26, i32 0, i32 0, i32 0, i32 0, i32 0, %complex_4* %x)
  %28 = load i64, i64* %26, align 8
  call void @llvm.stackrestore(i8* %25)
  %29 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 0
  store i8* %27, i8** %29, align 8
  %30 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 1
  store i64 %28, i64* %30, align 8
  %31 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 0
  %32 = load i8*, i8** %31, align 8
  %33 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 1
  %34 = load i64, i64* %33, align 8
  %35 = trunc i64 %34 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @1, i32 0, i32 0), i8* %32, i32 %35, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @0, i32 0, i32 0), i32 1)
  %36 = icmp eq i8* %27, null
  br i1 %36, label %free_done, label %free_nonnull

free_nonnull:                                     ; preds = %complex_div_cont
  call void @_lfortran_free_alloc(i8* %2, i8* %27)
  br label %free_done

free_done:                                        ; preds = %free_nonnull, %complex_div_cont
  %37 = load %complex_4, %complex_4* %x, align 1
  %38 = extractvalue %complex_4 %37, 0
  %39 = extractvalue %complex_4 %37, 1
  %40 = call float @llvm.fabs.f32(float %38)
  %41 = call float @llvm.fabs.f32(float %39)
  %42 = fcmp oge float %40, %41
  br i1 %42, label %complex_div_r_ge_s1, label %complex_div_r_lt_s2

complex_div_r_ge_s1:                              ; preds = %free_done
  %43 = fdiv float %39, %38
  %44 = fmul float %39, %43
  %45 = fadd float %38, %44
  %46 = fmul float 0.000000e+00, %43
  %47 = fadd float 2.000000e+00, %46
  %48 = fmul float 2.000000e+00, %43
  %49 = fsub float 0.000000e+00, %48
  %50 = fdiv float %47, %45
  %51 = fdiv float %49, %45
  br label %complex_div_cont3

complex_div_r_lt_s2:                              ; preds = %free_done
  %52 = fdiv float %38, %39
  %53 = fmul float %38, %52
  %54 = fadd float %39, %53
  %55 = fmul float 2.000000e+00, %52
  %56 = fadd float %55, 0.000000e+00
  %57 = fmul float 0.000000e+00, %52
  %58 = fsub float %57, 2.000000e+00
  %59 = fdiv float %56, %54
  %60 = fdiv float %58, %54
  br label %complex_div_cont3

complex_div_cont3:                                ; preds = %complex_div_r_lt_s2, %complex_div_r_ge_s1
  %61 = phi float [ %50, %complex_div_r_ge_s1 ], [ %59, %complex_div_r_lt_s2 ]
  %62 = phi float [ %51, %complex_div_r_ge_s1 ], [ %60, %complex_div_r_lt_s2 ]
  %63 = insertvalue %complex_4 undef, float %61, 0
  %64 = insertvalue %complex_4 %63, float %62, 1
  store %complex_4 %64, %complex_4* %x, align 1
  %65 = call i8* @llvm.stacksave()
  %66 = alloca i64, align 8
  %67 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, ...) @_lcompilers_string_format_fortran(i8* %2, i8* null, i64 0, i8* getelementptr inbounds ([8 x i8], [8 x i8]* @serialization_info.1, i32 0, i32 0), i64* %66, i32 0, i32 0, i32 0, i32 0, i32 0, %complex_4* %x)
  %68 = load i64, i64* %66, align 8
  call void @llvm.stackrestore(i8* %65)
  %69 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 0
  store i8* %67, i8** %69, align 8
  %70 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 1
  store i64 %68, i64* %70, align 8
  %71 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 0
  %72 = load i8*, i8** %71, align 8
  %73 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 1
  %74 = load i64, i64* %73, align 8
  %75 = trunc i64 %74 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @3, i32 0, i32 0), i8* %72, i32 %75, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @2, i32 0, i32 0), i32 1)
  %76 = icmp eq i8* %67, null
  br i1 %76, label %free_done6, label %free_nonnull5

free_nonnull5:                                    ; preds = %complex_div_cont3
  call void @_lfortran_free_alloc(i8* %2, i8* %67)
  br label %free_done6

free_done6:                                       ; preds = %free_nonnull5, %complex_div_cont3
  %77 = load %complex_4, %complex_4* %x, align 1
  %78 = extractvalue %complex_4 %77, 0
  %79 = extractvalue %complex_4 %77, 1
  %80 = fadd float %78, 0.000000e+00
  %81 = fadd float %79, 3.000000e+00
  %82 = insertvalue %complex_4 undef, float %80, 0
  %83 = insertvalue %complex_4 %82, float %81, 1
  %84 = extractvalue %complex_4 %83, 0
  %85 = extractvalue %complex_4 %83, 1
  %86 = call float @llvm.fabs.f32(float %84)
  %87 = call float @llvm.fabs.f32(float %85)
  %88 = fcmp oge float %86, %87
  br i1 %88, label %complex_div_r_ge_s7, label %complex_div_r_lt_s8

complex_div_r_ge_s7:                              ; preds = %free_done6
  %89 = fdiv float %85, %84
  %90 = fmul float %85, %89
  %91 = fadd float %84, %90
  %92 = fmul float 0.000000e+00, %89
  %93 = fadd float 1.000000e+00, %92
  %94 = fmul float 1.000000e+00, %89
  %95 = fsub float 0.000000e+00, %94
  %96 = fdiv float %93, %91
  %97 = fdiv float %95, %91
  br label %complex_div_cont9

complex_div_r_lt_s8:                              ; preds = %free_done6
  %98 = fdiv float %84, %85
  %99 = fmul float %84, %98
  %100 = fadd float %85, %99
  %101 = fmul float 1.000000e+00, %98
  %102 = fadd float %101, 0.000000e+00
  %103 = fmul float 0.000000e+00, %98
  %104 = fsub float %103, 1.000000e+00
  %105 = fdiv float %102, %100
  %106 = fdiv float %104, %100
  br label %complex_div_cont9

complex_div_cont9:                                ; preds = %complex_div_r_lt_s8, %complex_div_r_ge_s7
  %107 = phi float [ %96, %complex_div_r_ge_s7 ], [ %105, %complex_div_r_lt_s8 ]
  %108 = phi float [ %97, %complex_div_r_ge_s7 ], [ %106, %complex_div_r_lt_s8 ]
  %109 = insertvalue %complex_4 undef, float %107, 0
  %110 = insertvalue %complex_4 %109, float %108, 1
  store %complex_4 %110, %complex_4* %x, align 1
  %111 = call i8* @llvm.stacksave()
  %112 = alloca i64, align 8
  %113 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, ...) @_lcompilers_string_format_fortran(i8* %2, i8* null, i64 0, i8* getelementptr inbounds ([8 x i8], [8 x i8]* @serialization_info.2, i32 0, i32 0), i64* %112, i32 0, i32 0, i32 0, i32 0, i32 0, %complex_4* %x)
  %114 = load i64, i64* %112, align 8
  call void @llvm.stackrestore(i8* %111)
  %115 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc10, i32 0, i32 0
  store i8* %113, i8** %115, align 8
  %116 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc10, i32 0, i32 1
  store i64 %114, i64* %116, align 8
  %117 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc10, i32 0, i32 0
  %118 = load i8*, i8** %117, align 8
  %119 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc10, i32 0, i32 1
  %120 = load i64, i64* %119, align 8
  %121 = trunc i64 %120 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @5, i32 0, i32 0), i8* %118, i32 %121, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @4, i32 0, i32 0), i32 1)
  %122 = icmp eq i8* %113, null
