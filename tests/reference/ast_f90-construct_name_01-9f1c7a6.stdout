program construct_name_01
! Named IF, SELECT CASE, SELECT TYPE, DO WHILE, DO CONCURRENT and
! WHERE constructs, whose END statements must repeat the name
implicit none
integer :: i, n
real :: a(4)
class(*), allocatable :: p
n = 0
chk: if (n > 0) then
    n = 10
else
    if (n < 0) then
        n = 20
    else
        n = 1
    end if
end if chk
if (n /= 1) error stop
sel: select case (n)
    case (1)
        n = 2
    case default
        n = 30
end select sel
if (n /= 2) error stop
w: do while (n < 100)
    n = n + 1
    if (n == 5) exit w
end do w
if (n /= 5) error stop
dc: do concurrent (i = 1:4)
    a(i) = i - 2
end do dc
wh: where (a > 0)
    a = 1
elsewhere
    a = -1
end where wh
if (any(a /= [-1, -1, 1, 1])) error stop
p = n
st: select type (p)
    type is (integer)
        n = p + 1
    class default
        n = 0
end select st
if (n /= 6) error stop
end program construct_name_01
