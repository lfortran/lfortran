}

// The lanes are the warps of a block: each combines its own lanes,
// and every lane then folds the partial results of the warps in the
// same order.
template <int op, typename T>
__device__ __noinline__ T __lfortran_block_reduce(T v, int lanes) {
    #pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1) {
        v = __lfortran_lane_combine<op>(v,
            __shfl_xor_sync(0xffffffffu, v, offset, 32));
    }
    __shared__ T partial[32];
    if ((threadIdx.x & 31u) == 0) partial[threadIdx.x >> 5] = v;
    __syncthreads();
    T r = partial[0];
    for (int i = 1; i < (lanes >> 5); i++) {
        r = __lfortran_lane_combine<op>(r, partial[i]);
    }
    __syncthreads();
    return r;
