#include <math.h>
#include <iostream>
#include <string>
#include <vector>
#include <cassert>
#include <cmath>
#include <complex>
#include <type_traits>
#include <Kokkos_Core.hpp>
#include <lfortran_intrinsics.h>

template <typename T>
Kokkos::View<T*> from_std_vector(const std::vector<T> &v)
{
    Kokkos::View<T*> r("r", v.size());
    for (size_t i=0; i < v.size(); i++) {
        r(i) = v[i];
    }
    return r;
}

// Forward declarations
float _lfortran_ssin(float x);
float _lcompilers_sin_f32(float x);
double _lfortran_dsin(double x);
double _lcompilers_sin_f64(double x);
namespace {
}

// Implementations
float _lfortran_ssin(float x);


float _lcompilers_sin_f32(float x)
{
    float _lcompilers_sin_f32;
    _lcompilers_sin_f32 = _lfortran_ssin(x);
    return _lcompilers_sin_f32;
}

double _lfortran_dsin(double x);


double _lcompilers_sin_f64(double x)
{
    double _lcompilers_sin_f64;
    _lcompilers_sin_f64 = _lfortran_dsin(x);
    return _lcompilers_sin_f64;
}

namespace {

void main2() {
    static float x=  9.97494986604054446e-01;
    double y;
    y =   9.97494986604054446e-01;
    std::cout << (x) << " " << (y) << std::endl;
    if (fabs(x -   9.97494995594024658e-01) >   9.99999997475242708e-07) {
        std::cerr << "ERROR STOP" << std::endl;
        exit(1);
    }
    if (fabs(_lcompilers_sin_f32(x) -   8.40114891529083252e-01) >   9.99999997475242708e-07) {
        std::cerr << "ERROR STOP" << std::endl;
        exit(1);
    }
    if (fabs(y -   9.97494995594024658e-01) >   1.00000001168609742e-07) {
        std::cerr << "ERROR STOP" << std::endl;
        exit(1);
    }
    if (  0.00000000000000000e+00 >   1.00000001168609742e-07) {
        std::cerr << "ERROR STOP" << std::endl;
        exit(1);
    }
    if (fabs(_lcompilers_sin_f64(_lcompilers_sin_f64(y) + _lcompilers_sin_f32(x + _lcompilers_sin_f32(x))) -   9.72761869430541992e-01) >   1.00000001168609742e-07) {
        std::cerr << "ERROR STOP" << std::endl;
        exit(1);
    }
}

}
int main(int argc, char* argv[])
{
    Kokkos::initialize(argc, argv);
    main2();
    Kokkos::finalize();
    return 0;
}
